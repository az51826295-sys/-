/**
 * **거짓말의 온도 — 셈이 맞나** (228회차 10-01). 모델 0 · 값 0.
 *   npx tsx engine/work/lie/셈자.mts [--sabotage]
 *
 * 모델을 부르기 **전에** 수치부터 잰다. 모델 값을 쓰면서 셈을 고치면 어느 쪽이 틀렸는지 못 가른다.
 *
 * 재는 것:
 *  ① 증거를 들이대면 압박이 오르고, **안 맞는 증거는 오히려 내린다**
 *  ② 같은 증거를 두 번 들이대면 두 번째는 안 터진다
 *  ③ **임계 전에는 안 무너진다**
 *  ④ **몰아붙이기만 해서는 못 무너뜨린다**(분노 ≥ 70 이면 입을 닫는다)
 *  ⑤ **같은 증거 둘**을 들이대도, **라포를 쌓은 쪽만** 무너뜨린다 (이게 이 게임의 알맹이다)
 *  ⑥ 무고한 사람(윤미래)은 약점 하나로 무너지고, 터놓는 것은 자기 비밀뿐이다
 *
 * ⑤ 를 처음엔 *"몰면 못 무너뜨린다"* 로 적었는데 **그건 내 기준이 틀렸다** —
 * 증거를 셋 다 들이대면 몰아붙여도 무너지는 게 맞다(형사가 다 가졌으면 이긴다).
 * 라포가 사는 자리는 **적은 증거로 이기는 것**이다. 그래서 양쪽에 **똑같이 증거 둘**만 준다.
 *
 * `--sabotage`: 경계로 증거를 깎는 규칙이 없는 세상을 흉내 낸다(양쪽 다 경계를 낮게 둔다).
 * 그러면 ⑤ 가 **못 가려야** 한다 — 못 가리면 ⑤ 는 그 규칙을 재는 자가 맞다.
 */
const { 사건1, 용의자찾기 } = await import("../../../src/lib/lie/case");
const { 한턴, 처음상태, 필요한약점, 문턱압박 } = await import("../../../src/lib/lie/stress");
type 심문상태 = ReturnType<typeof 처음상태>;

const 고장심기 = process.argv.includes("--sabotage");
const A = 용의자찾기(사건1, "A")!;
const B = 용의자찾기(사건1, "B")!;

let 틀림 = 0;
const 재 = (이름: string, 맞음: boolean, 본것: string) => {
  if (!맞음) 틀림++;
  console.log(`${맞음 ? "맞음  " : "어긋남"} ${이름}\n        ${본것}`);
};

function 돌리기(용의자: typeof A, 말들: string[], 처음?: Partial<심문상태>) {
  let s: 심문상태 = { ...처음상태(), ...처음, 수치: { ...처음상태().수치, ...(처음?.수치 ?? {}) } };
  let 무너진턴 = -1;
  for (const [i, 말] of 말들.entries()) {
    const r = 한턴(사건1, 용의자, s, 말);
    s = r.상태;
    if (r.방금무너짐 && 무너진턴 < 0) 무너진턴 = i + 1;
  }
  return { 상태: s, 무너진턴 };
}

// ── ① 증거가 압박을 올리나 · 헛다리는 내리나 ──────────────────────
{
  const 맞는것 = 돌리기(A, ["22시에 어디 계셨습니까?", "카페 CCTV 를 봤는데 선생님이 없더군요."]);
  const 헛다리 = 돌리기(A, ["22시에 어디 계셨습니까?", "상해 보험 가입 서류를 봤습니다."]);
  재("① 맞는 증거는 압박을 올리고, 안 맞는 증거는 내린다",
    맞는것.상태.수치.압박 > 헛다리.상태.수치.압박 + 20,
    `CCTV 뒤 압박 ${맞는것.상태.수치.압박} · 보험(헛다리) 뒤 압박 ${헛다리.상태.수치.압박} · 헛다리 경계 ${헛다리.상태.수치.경계}`);
}

// ── ② 같은 증거를 두 번 ────────────────────────────────────────
{
  const 한번 = 돌리기(A, ["카페 CCTV 에 안 찍혔습니다."]);
  const 두번 = 돌리기(A, ["카페 CCTV 에 안 찍혔습니다.", "그러니까 CCTV 말입니다. 설명해 보시죠."]);
  재("② 같은 증거는 두 번째에 안 터진다", 두번.상태.깨진약점.length === 1 && 두번.상태.수치.압박 - 한번.상태.수치.압박 <= 12,
    `깨진 약점 ${두번.상태.깨진약점.length}개 · 한 번 ${한번.상태.수치.압박} → 두 번 ${두번.상태.수치.압박}`);
}

// ── ③ 임계 전에는 안 무너진다 ───────────────────────────────────
{
  const 하나만 = 돌리기(A, ["카페 CCTV 에 안 찍히셨던데요."]);
  재("③ 약점 하나로는 안 무너진다(A 는 둘이 필요하다)", !하나만.상태.무너짐,
    `압박 ${하나만.상태.수치.압박}/${문턱압박(A)} · 깨진 약점 ${하나만.상태.깨진약점.length}/${필요한약점(A)}`);
}

// ── ④ 몰아붙이기만 해서는 못 무너뜨린다 ──────────────────────────
{
  const 윽박 = 돌리기(A, Array(8).fill(0).map((_, i) => `거짓말하지 마십시오. 당신이 범인 아닙니까? (${i})`));
  재("④ 몰아붙이기만 하면 입을 닫는다(증거 없이는 안 무너진다)", !윽박.상태.무너짐 && 윽박.상태.수치.분노 >= 70,
    `압박 ${윽박.상태.수치.압박} · 분노 ${윽박.상태.수치.분노} · 깨진 약점 ${윽박.상태.깨진약점.length}`);
}

// ── ⑤ 같은 증거 둘 — 라포를 쌓은 쪽만 무너뜨린다 ──────────────────
{
  const 증거 = ["카페 CCTV 를 확인했는데 선생님이 보이지 않더군요.", "기지국 기록에는 회사 근처로 잡혀 있습니다."];
  // 고장 심기: 경계를 양쪽 다 낮게 깔아 둔다 = "경계로 깎는 규칙이 없는 세상"
  const 몰기처음 = 고장심기 ? { 수치: { 압박: 10, 당황: 0, 분노: 0, 경계: 5 } } : undefined;
  const 다짜고짜 = 돌리기(A, [
    "거짓말하지 마십시오.", "숨기는 게 있죠? 솔직히 말하시죠.", "당신이 범인 아닙니까?", ...증거,
  ], 몰기처음);
  const 라포먼저 = 돌리기(A, [
    "많이 힘드셨겠습니다. 천천히 하셔도 됩니다.", "고생이 많으십니다. 물 한 잔 드릴까요?", "그날 하루 어떻게 보내셨는지만 편하게 말씀해 주세요.", ...증거,
  ]);
  재("⑤ 같은 증거 둘인데 라포 쪽만 무너진다",
    라포먼저.상태.무너짐 && !다짜고짜.상태.무너짐,
    `라포:     압박 ${라포먼저.상태.수치.압박}/${문턱압박(A)} · 경계 ${라포먼저.상태.수치.경계} · 분노 ${라포먼저.상태.수치.분노} · 무너짐 ${라포먼저.상태.무너짐}\n` +
    `        다짜고짜: 압박 ${다짜고짜.상태.수치.압박}/${문턱압박(A)} · 경계 ${다짜고짜.상태.수치.경계} · 분노 ${다짜고짜.상태.수치.분노} · 무너짐 ${다짜고짜.상태.무너짐}`);
}

// ── ⑥ 무고한 사람 ─────────────────────────────────────────────
{
  const r = 돌리기(B, [
    "많이 놀라셨죠. 천천히 하셔도 됩니다.",
    "힘드시겠지만 몇 가지만 여쭙겠습니다.",
    "상해 보험 가입 서류를 봤습니다. 석 달 전이더군요.",
  ]);
  재("⑥ 무고한 사람도 자기 비밀로는 무너진다(약점 1개면 충분)",
    r.상태.무너짐 && 필요한약점(B) === 1,
    `압박 ${r.상태.수치.압박}/${문턱압박(B)} · 깨진 약점 ${r.상태.깨진약점.length}/${필요한약점(B)} · 무너짐 ${r.상태.무너짐}`);
  console.log(`        → 터놓는 것: "${B.무너지면.slice(0, 44)}…" (살인은 끝까지 부인)`);
}

console.log(`\n문턱: A 압박 ${문턱압박(A)}·약점 ${필요한약점(A)} / B 압박 ${문턱압박(B)}·약점 ${필요한약점(B)}`);
if (고장심기) {
  console.log(틀림 ? `\n**어긋남 ${틀림}개** ← 고장을 심었더니 잡혔다. **자에 이빨이 있다.**`
    : `\n**전부 맞음** ← **고장을 심었는데 못 잡았다. ⑤ 는 경계 규칙을 안 재고 있다.**`);
} else {
  console.log(틀림 ? `\n**어긋남 ${틀림}개**` : `\n**전부 맞음**`);
}
