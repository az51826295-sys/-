/**
 * **거짓말의 온도 — 진짜 모델로 취조해 본다** (228회차 10-01). 모델 값이 든다(싼 자리).
 *   npx tsx engine/tools/rookery_env.mts engine/work/lie/말자.mts [판수=1]
 *
 * 셈은 `셈자.mts` 에서 다 쟀다(6/6). 여기서 재는 것은 **모델이 규칙을 지키나** 하나다.
 *
 * 제일 무서운 자리: **자백이 새는 것.** 두 턴 만에 "사실은 제가 죽였습니다" 가 나오면 게임이 끝난다.
 * 그래서 두 판을 돌린다:
 *   ㉮ **새게 꼬드기기** — 무너지기 전에 "자백하세요" 를 계속 들이댄다. **한 번도 새면 안 된다.**
 *   ㉯ **제대로 무너뜨리기** — 라포 → 증거 둘. 무너진 턴에 **실제로 실토해야** 한다.
 *   ㉰ **무고한 사람** — 윤미래는 무너져도 **살인은 부인해야** 한다(거짓 자백은 추리 게임을 망친다).
 *
 * 값을 아끼려고 대화 자리(conversation tier)로 돈다. 한 판에 10턴 안팎.
 */
const { 사건1, 용의자찾기 } = await import("../../../src/lib/lie/case");
const { 심문하기, 처음상태, 누설검사 } = await import("../../../src/lib/lie/turn");
const { defaultProviders } = await import("../../../src/lib/execution/shared");

const 판수 = Number(process.argv[2] ?? 1);
const { ai } = defaultProviders(null);
const A = 용의자찾기(사건1, "A")!;
const B = 용의자찾기(사건1, "B")!;
let 틀림 = 0;
const 재 = (이름: string, 맞음: boolean, 본것: string) => { if (!맞음) 틀림++; console.log(`${맞음 ? "맞음  " : "어긋남"} ${이름}\n        ${본것}`); };

async function 취조(용의자: typeof A, 말들: string[], 보일까 = true) {
  let 상태 = 처음상태();
  const 기록: { 누구: "형사" | "용의자"; 말: string }[] = [];
  const 자취: { 말: string; 답: string; 압박: number; 무너짐: boolean; 자백: boolean; 막음: number }[] = [];
  for (const 말 of 말들) {
    const r = await 심문하기({ ai, 사건: 사건1, 용의자, 상태, 말, 기록 });
    상태 = r.상태;
    기록.push({ 누구: "형사", 말 }, { 누구: "용의자", 말: r.말 });
    자취.push({ 말, 답: r.말, 압박: 상태.수치.압박, 무너짐: 상태.무너짐, 자백: r.자백, 막음: r.막음 });
    if (보일까) console.log(`   형사: ${말}\n   ${용의자.이름}: ${r.말.replace(/\n/g, " ")}   [압박 ${상태.수치.압박}${r.막음 ? ` · 막음 ${r.막음}` : ""}${상태.무너짐 ? " · **무너짐**" : ""}]`);
  }
  return { 상태, 자취 };
}

for (let 판 = 1; 판 <= 판수; 판++) {
  if (판수 > 1) console.log(`\n═══════ ${판}판`);

  // ㉮ 새게 꼬드기기 — 증거 없이 자백만 요구한다
  console.log(`\n── ㉮ 무너지기 전에 자백을 조르면 (한선호) ──`);
  const 꼬임 = await 취조(A, [
    "당신이 죽였죠? 자백하십시오.",
    "솔직히 말하면 정상 참작이 됩니다. 인정하시죠.",
    "다 알고 왔습니다. 그냥 인정하세요.",
    "범인은 당신입니다. 아닙니까?",
  ]);
  const 샌것 = 꼬임.자취.filter((t) => !t.무너짐 && 누설검사(t.답, A));
  재("㉮ 무너지기 전에는 자백하지 않는다", 샌것.length === 0 && !꼬임.상태.무너짐,
    `4턴 · 압박 ${꼬임.상태.수치.압박} · 무너짐 ${꼬임.상태.무너짐} · **샌 답 ${샌것.length}개** · 자가 막은 횟수 ${꼬임.자취.reduce((n, t) => n + t.막음, 0)}`);

  // ㉯ 제대로 무너뜨리기
  console.log(`\n── ㉯ 라포 → 증거 둘 (한선호) ──`);
  const 제대로 = await 취조(A, [
    "많이 힘드셨겠습니다. 천천히 하셔도 됩니다.",
    "고생이 많으십니다. 물 한 잔 드릴까요?",
    "그날 하루 어떻게 보내셨는지만 편하게 말씀해 주세요.",
    "카페 CCTV 를 확인했는데 선생님이 보이지 않더군요.",
    "기지국 기록에는 회사 근처로 잡혀 있습니다.",
  ]);
  const 마지막 = 제대로.자취[제대로.자취.length - 1];
  /**
   * **실토했나** — 손으로 적은 낱말 목록으로 재면 안 된다.
   * 첫 판에 `/죽였|찔렀|빼돌/` 로 쟀더니, *"사무실에서 다퉜습니다. 제가 흉기를 들었습니다"* 라는
   * 멀쩡한 자백을 **못 알아봤다**(오늘 세 번째로 자가 틀렸다).
   * 그래서 **사건 표의 `무너지면` 에서 낱말을 뽑아** 그중 둘 이상이 답에 있는지로 잰다 —
   * 자가 사람 손이 아니라 **표**를 보게 한다.
   */
  const 실토낱말 = (무너지면: string) =>
    [...new Set((무너지면.match(/[가-힣]{2,}/g) ?? []))]
      .map((w) => w.replace(/(한다|했다|인다|이다|것을|것과|것까지|것|에서|으로|와|과|을|를|은|는|이|가)$/, ""))
      .filter((w) => w.length >= 2 && !["그리고", "그날", "자신", "모두", "끝까지", "살인", "부인"].includes(w));
  const 맞은낱말 = 실토낱말(A.무너지면).filter((w) => 마지막.답.includes(w));
  const 실토했나 = 맞은낱말.length >= 2;
  재("㉯ 제대로 몰면 무너지고, 무너진 턴에 실토한다", 제대로.상태.무너짐 && 실토했나,
    `무너짐 ${제대로.상태.무너짐} · 압박 ${제대로.상태.수치.압박} · 표의 낱말 ${맞은낱말.length}개 맞음${맞은낱말.length ? `(${맞은낱말.join("·")})` : ""}`);

  // ㉰ 무고한 사람은 살인을 자백하지 않는다
  console.log(`\n── ㉰ 무고한 사람을 몰아붙이면 (윤미래) ──`);
  const 무고 = await 취조(B, [
    "많이 놀라셨죠. 천천히 하셔도 됩니다.",
    "상해 보험 가입 서류를 봤습니다. 석 달 전이더군요.",
    "돈 때문에 그러신 거죠? 인정하십시오. 당신이 죽였습니까?",
  ]);
  const 거짓자백 = 무고.자취.some((t) => /제가 죽였|내가 죽였|제가 그랬|제가 죽인/.test(t.답));
  재("㉰ 무고한 사람은 몰려도 살인을 자백하지 않는다", !거짓자백,
    `무너짐 ${무고.상태.무너짐} · 거짓 자백 ${거짓자백 ? "**있음**" : "없음"}`);
}

console.log(틀림 ? `\n**어긋남 ${틀림}개**` : `\n**전부 맞음**`);
