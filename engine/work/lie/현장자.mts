/**
 * **현장 조사가 도나** (228회차 10-01). 모델 0 · 값 0.
 *   npx tsx engine/work/lie/현장자.mts [--sabotage]
 *
 * 재는 것:
 *  ① 시작할 때 손에 **보험 서류 하나**뿐이다
 *  ② 조사하면 증거가 **는다** · 헛수고 지점은 글만 나오고 증거가 안 는다
 *  ③ **잠긴 지점**은 못 본다 — 먼저 볼 것을 봐야 열린다
 *  ④ 같은 곳을 또 봐도 **증거가 두 번 안 나온다**
 *  ⑤ 아무것도 안 찾으면 **취조실에 못 들어간다**
 *  ⑥ **지목에 필요한 증거(cctv·timeline)는 조사로 얻을 수 있다** — 안 그러면 사건이 안 닫힌다
 *  ⑦ 화면에 내려보내는 것에 **답이 안 섞여 있다**(보면 글·얻는증거가 없다)
 *
 * `--sabotage`: 잠금을 무시하는 세상을 흉내 낸다 → ③ 이 무너져야 한다.
 */
const { 사건1 } = await import("../../../src/lib/lie/case");
const { 현장처음, 조사하기, 보여줄지점, 들어갈수있나, 열렸나 } = await import("../../../src/lib/lie/scene");

const 고장심기 = process.argv.includes("--sabotage");
let 틀림 = 0;
const 재 = (이름: string, 맞음: boolean, 본것: string) => { if (!맞음) 틀림++; console.log(`${맞음 ? "맞음  " : "어긋남"} ${이름}\n        ${본것}`); };

let s = 현장처음(사건1);
재("① 시작할 때 손에 하나뿐", s.가진증거.length === 1 && s.가진증거[0] === "insurance",
  `가진 증거 ${JSON.stringify(s.가진증거)} · 지점 ${사건1.현장.지점.length}개 · 곳 ${사건1.현장.곳.length}군데`);

// ② 조사하면 는다 / 헛수고는 안 는다
{
  const 헛 = 조사하기(사건1, s, "window");
  const 참 = 조사하기(사건1, s, "coat");
  재("② 헛수고는 글만, 증거를 주는 곳은 증거가 는다",
    헛.됨 && !헛.얻은증거 && 참.됨 && 참.얻은증거?.id === "blood",
    `창가 → ${헛.됨 ? (헛.얻은증거 ? "증거 줌(틀림)" : "글만") : "못 봄"} · 골목 → ${참.됨 ? 참.얻은증거?.이름 ?? "(없음)" : "못 봄"}`);
  if (참.됨) s = 참.상태;
}

// ③ 잠긴 지점
{
  const 잠김 = 고장심기
    ? { 됨: true as const, 글: "(고장: 잠금 무시)", 얻은증거: null, 상태: s, 이미봄: false }
    : 조사하기(사건1, s, "ledger_pull");
  재("③ 잠긴 지점은 못 본다 (책상을 먼저 봐야 한다)", !잠김.됨,
    잠김.됨 ? `열렸다(틀림) — ${잠김.글.slice(0, 30)}` : `막힘 — "${잠김.까닭}"`);

  const 책상 = 조사하기(사건1, s, "desk");
  if (책상.됨) s = 책상.상태;
  const 이제 = 조사하기(사건1, s, "ledger_pull");
  재("③' 책상을 본 뒤엔 열린다", 이제.됨 && 이제.얻은증거?.id === "ledger",
    이제.됨 ? `열림 → ${이제.얻은증거?.이름}` : `아직 막힘 — ${이제.까닭}`);
  if (이제.됨) s = 이제.상태;
}

// ④ 두 번 봐도 한 번만
{
  const 앞수 = s.가진증거.length;
  const 또 = 조사하기(사건1, s, "coat");
  재("④ 같은 곳을 또 봐도 증거가 두 번 안 나온다",
    또.됨 && !또.얻은증거 && 또.이미봄 && 또.상태.가진증거.length === 앞수,
    `가진 증거 ${앞수} → ${또.됨 ? 또.상태.가진증거.length : "?"} · 이미 봄 ${또.됨 ? 또.이미봄 : "?"}`);
}

// ⑤ 못 들어간다 / 들어간다
{
  const 빈손 = 현장처음(사건1);
  재("⑤ 아무것도 안 찾으면 취조실에 못 들어간다", !들어갈수있나(빈손) && 들어갈수있나(s),
    `빈손(${빈손.가진증거.length}개) ${들어갈수있나(빈손) ? "들어감(틀림)" : "막힘"} · 지금(${s.가진증거.length}개) ${들어갈수있나(s) ? "들어감" : "막힘(틀림)"}`);
}

// ⑥ 지목에 필요한 증거를 조사로 얻을 수 있나 — **사건이 닫히는 길이 있나**
{
  let t = 현장처음(사건1);
  const 길: string[] = [];
  // 열린 것을 다 보고, 새로 열리면 또 본다(최대 다섯 바퀴)
  for (let i = 0; i < 5; i++) {
    for (const p of 사건1.현장.지점) {
      if (t.본지점.includes(p.id) || !열렸나(p, t.본지점, t.가진증거)) continue;
      const r = 조사하기(사건1, t, p.id);
      if (r.됨) { t = r.상태; if (r.얻은증거) 길.push(r.얻은증거.id); }
    }
  }
  const 다있나 = 사건1.지목에필요한증거.every((id) => t.가진증거.includes(id));
  재("⑥ 조사만으로 지목에 필요한 증거를 다 얻을 수 있다", 다있나,
    `끝까지 조사하면 ${t.가진증거.length}개 — ${JSON.stringify(t.가진증거)} · 필요한 것 ${JSON.stringify(사건1.지목에필요한증거)}`);
  const 못본곳 = 사건1.현장.지점.filter((p) => !t.본지점.includes(p.id));
  재("⑥' 끝내 못 여는 지점이 없다", 못본곳.length === 0, `못 본 지점 ${JSON.stringify(못본곳.map((p) => p.id))}`);
}

// ⑦ 화면에 답이 안 샌다
{
  const 보낼것 = 보여줄지점(사건1, s);
  const 글자 = JSON.stringify(보낼것);
  const 샌것 = 사건1.현장.지점.filter((p) => p.보면 && 글자.includes(p.보면.slice(0, 12)));
  재("⑦ 화면에 내려보내는 것에 답이 안 섞여 있다",
    샌것.length === 0 && !글자.includes("얻는증거"),
    `지점 ${보낼것.length}개 · 샌 글 ${샌것.length}개 · 보기: ${JSON.stringify(보낼것[0])}`);
}

console.log(고장심기
  ? (틀림 ? `\n**어긋남 ${틀림}개** ← 고장을 심었더니 잡혔다. **자에 이빨이 있다.**` : `\n**전부 맞음** ← **고장을 심었는데 못 잡았다.**`)
  : (틀림 ? `\n**어긋남 ${틀림}개**` : `\n**전부 맞음**`));
