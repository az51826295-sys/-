/**
 * **로키가 정한다** (228회차 10-01, 사장님 "로키가 정하라고 해"). 모델 값이 든다(판단 자리 ×10~12).
 *   npx tsx engine/tools/rookery_env.mts engine/work/lie/로키가정한다.mts [판수=5]
 *
 * 10-01 아침엔 **물어본 것**이었다(③ 2 · ② 1 로 갈려서 "고르는 건 사장님 몫" 으로 끝냄).
 * 지금은 사장님이 **정하는 자리까지 넘기셨다.** 그래서 달라지는 게 둘 있다.
 *
 * 1. **다섯 번 묻는다.** 세 번은 2:1 로 갈려도 "갈렸다" 로 끝낼 수 있었지만, 이제는 끝낼 수 없다.
 * 2. **갈리면 결선을 한 판 더 돈다.** 1등과 2등만 놓고 "둘 중 하나" 로 다시 묻는다.
 *    그래도 안 갈라지면 그때는 **1등 표를 따른다** — 동점이면 첫 표를 따른다. 내가 끼어들지 않는다.
 *
 * 묻는 것은 둘이다: **세계관**(①②③)과 **얼굴 그림체**(사진·도트·반실사).
 * 그림체는 세계관이 정해진 뒤에 묻는다 — 톤이 정해져야 그림체가 따라오지, 거꾸로가 아니다.
 */
import { readFileSync } from "node:fs";
import { z } from "zod";

const { defaultProviders } = await import("../../../src/lib/execution/shared");
const 판수 = Number(process.argv[2] ?? 5);
const { ai } = defaultProviders(null);

/** 로키에게 유리하게 묻지 않는다 — 제안서에서 **내 생각은 빼고** 넘긴다(메아리 방지). */
const 제안서 = readFileSync("engine/docs/lie-world-proposal.md", "utf8").split("## 로키에게 물어봤다")[0];

const 공통 = [
  "너는 만들던 게임의 방향을 **정하는 자리**에 있다. 한국어로 답한다.",
  "",
  "- 만드는 사람은 **학생 한 명**이고 주말에 두세 시간 쓴다. 끝낼 수 있는 크기인지도 본다.",
  "- 지금 돌아가는 것: 수치 넷(압박·당황·분노·경계)을 코드가 세고, 현장 조사 9곳, 교차 검증, 최종 지목이 붙어 있다.",
  "- **좋은 말만 하지 마라.** 고른 것의 약점을 반드시 하나 댄다.",
].join("\n");

type 한판 = { 고른것: string; 한줄: string; 까닭: string[]; 걸리는점: string; 첫조각: string };

async function 묻기(이름: string, 지시문: string, 물음: string, 보기: [string, ...string[]], 판: number) {
  const 꼴 = z.object({
    고른것: z.enum(보기),
    한줄: z.string().describe("고른 까닭 한 줄"),
    까닭: z.array(z.string()).describe("2~4줄. 왜 이게 나은가 — 분위기가 아니라 **규칙**으로."),
    걸리는점: z.string().describe("고른 것의 가장 큰 약점 하나. 없다고 하지 마라."),
    첫조각: z.string().describe("고르면 **가장 먼저 만들 것** 하나. 한 줄로."),
  });
  const 뽑은것: 한판[] = [];
  for (let i = 1; i <= 판; i++) {
    const { output } = await ai.generateStructuredOutput({
      systemInstructions: 지시문, input: 물음,
      schema: 꼴, schemaName: "pick", maxTokens: 16000, tier: "judgment",
    });
    const r = output as 한판;
    뽑은것.push(r);
    console.log(`  ${i}판 — **${r.고른것}** · ${r.한줄}`);
  }
  const 센것: Record<string, number> = {};
  for (const r of 뽑은것) 센것[r.고른것] = (센것[r.고른것] ?? 0) + 1;
  const 줄 = Object.entries(센것).sort((a, b) => b[1] - a[1]);
  console.log(`  ── ${이름}: ${줄.map(([k, n]) => `${k} ${n}표`).join(" · ")}`);
  return { 뽑은것, 줄, 센것 };
}

/** 갈리면 1·2등만 놓고 결선 한 판. 그래도 안 갈라지면 1등 표를 따른다 — 내가 안 끼어든다. */
async function 결선(이름: string, 지시문: string, 물음: string, 줄: [string, number][], 앞판: 한판[]) {
  if (줄.length === 1 || 줄[0][1] > 줄[1][1] + 1) return 줄[0][0];
  const 둘 = [줄[0][0], 줄[1][0]] as [string, string];
  console.log(`  갈렸다 → **결선** ${둘.join(" vs ")}`);
  const 근거 = 앞판.filter((r) => 둘.includes(r.고른것))
    .map((r) => `[${r.고른것}] ${r.한줄} / 약점: ${r.걸리는점}`).join("\n");
  const r = await 묻기(`${이름} 결선`, 지시문,
    `${물음}\n\n앞서 너 자신이 둘로 갈렸다. 네가 댄 까닭들이다:\n${근거}\n\n**${둘.join(" 와 ")} 둘 중 하나만** 골라라. 비기는 답은 없다.`,
    둘, 1);
  return r.줄[0][0];
}

// ── 1. 세계관 ───────────────────────────────────────────
console.log(`\n████ 세계관 — ${판수}판`);
const 세계물음 = `${제안서}\n\n위 셋 중 하나를 골라라. 고르는 기준은 하나다: **그 세계여야만 생기는 규칙이 있는가.** 분위기만 다르고 규칙이 같으면 껍데기다.`;
const 세계지시 = `${공통}\n\n고르는 기준은 하나다: **그 세계여야만 생기는 규칙이 있는가.** 분위기만 다르고 규칙이 같으면 그건 껍데기다 — 그런 쪽은 고르지 마라.`;
const 세계 = await 묻기("세계관", 세계지시, 세계물음, ["①", "②", "③"], 판수);
const 정한세계 = await 결선("세계관", 세계지시, 세계물음, 세계.줄 as [string, number][], 세계.뽑은것);

// ── 2. 얼굴 그림체 (세계관이 정해진 뒤에) ──────────────────
const 세계이름: Record<string, string> = { "①": "지금 이 자리 — 취조실", "②": "2049 심문국(온도가 진짜 기계)", "③": "감온자(온도가 사람에게 보이는 것)" };
console.log(`\n████ 얼굴 그림체 — ${판수}판 (세계관 ${정한세계} ${세계이름[정한세계]} 에 맞춰)`);
const 그림지시 = [공통, "",
  `세계관은 **${정한세계} ${세계이름[정한세계]}** 로 정해졌다. 거기에 맞는 얼굴 그림체를 고른다.`,
  "",
  "이 게임에서 화면의 주인공은 **얼굴과 글자**다. 3D·실사 배경은 안 만든다.",
  "압박이 오르면 얼굴이 달라져야 해서 **한 사람당 표정 3장(평온·흔들림·무너짐), 모두 9장**이 든다.",
].join("\n");
const 그림물음 = [
  "셋 중 하나를 골라라.",
  "",
  "**사진** — 지금 쓰고 있는 것. 사실적인 인물 사진 3장이 이미 있다.",
  "  무겁고 진지하다. 같은 사람의 다른 표정을 뽑기가 제일 어렵다(인물이 미묘하게 달라지면 바로 들킨다).",
  "",
  "**도트** — 두근도트에서 이미 해 봤다. 싸고 빠르고 표정을 많이 뽑을 수 있다.",
  "  대신 가벼워 보인다. 살인 사건 취조와 안 맞을 수 있다.",
  "",
  "**반실사** — 중간. 일러스트라 표정 9장을 같은 얼굴로 뽑기 쉽다.",
  "  대신 그림체가 흔들리면 제일 티가 나고, 사진보다 한 장당 손이 더 간다.",
  "",
  "기준은 **압박 수치가 얼굴로 보이는가**다. 예쁜 쪽이 아니라 **수치가 보이는 쪽**을 골라라.",
].join("\n");
const 그림 = await 묻기("그림체", 그림지시, 그림물음, ["사진", "도트", "반실사"], 판수);
const 정한그림 = await 결선("그림체", 그림지시, 그림물음, 그림.줄 as [string, number][], 그림.뽑은것);

// ── 적는다 ──────────────────────────────────────────────
console.log(`\n════════════════════════════════════════`);
console.log(`**로키가 정했다**`);
console.log(`  세계관: ${정한세계} ${세계이름[정한세계]}  (${세계.줄.map(([k, n]) => `${k} ${n}`).join(" · ")})`);
console.log(`  그림체: ${정한그림}  (${그림.줄.map(([k, n]) => `${k} ${n}`).join(" · ")})`);
console.log(`\n── 첫 조각으로 대라고 한 것 ──`);
for (const r of 세계.뽑은것.filter((x) => x.고른것 === 정한세계).slice(0, 3)) console.log(`  [세계] ${r.첫조각}`);
for (const r of 그림.뽑은것.filter((x) => x.고른것 === 정한그림).slice(0, 3)) console.log(`  [그림] ${r.첫조각}`);
console.log(`\n── 로키가 스스로 댄 약점(안 숨긴다) ──`);
for (const r of 세계.뽑은것.filter((x) => x.고른것 === 정한세계).slice(0, 2)) console.log(`  [세계] ${r.걸리는점}`);
for (const r of 그림.뽑은것.filter((x) => x.고른것 === 정한그림).slice(0, 2)) console.log(`  [그림] ${r.걸리는점}`);
