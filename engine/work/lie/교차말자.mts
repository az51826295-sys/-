/**
 * **교차 검증을 실제 모델로** (228회차 10-01). 모델 값이 든다(싼 자리, 6턴).
 *   npx tsx engine/tools/rookery_env.mts engine/work/lie/교차말자.mts
 *
 * 셈은 `교차자.mts` 에서 8/8 맞았다. 여기서 재는 것은 **말이 되나** 하나다.
 *
 * 한 판을 끝까지 돈다 — 이게 이 게임이 제대로 돌아가는 모습이어야 한다:
 *   ㉮ 한선호에게 알리바이를 듣는다 ("윤미래 씨와 카페에")
 *   ㉯ **윤미래에게 가서 확인한다** → 그 말이 **증언 증거**가 된다
 *   ㉰ 그 증언을 들고 **한선호에게 돌아간다** → 깨진다
 *
 * 재는 것: 윤미래가 **반박을 말하나** · 한선호가 **그 증언에 흔들리나** · 자백이 **안 새나**.
 */
const { 사건1, 용의자찾기, 가진증거 } = await import("../../../src/lib/lie/case");
const { 심문하기, 처음상태, 누설검사 } = await import("../../../src/lib/lie/turn");
const { defaultProviders } = await import("../../../src/lib/execution/shared");

const { ai } = defaultProviders(null);
const A = 용의자찾기(사건1, "A")!;
const B = 용의자찾기(사건1, "B")!;
let 틀림 = 0;
const 재 = (이름: string, 맞음: boolean, 본것: string) => { if (!맞음) 틀림++; console.log(`${맞음 ? "맞음  " : "어긋남"} ${이름}\n        ${본것}`); };

/** 사건 전체로 들고 다니는 증언. 방이 달라도 남는다. */
let 증언: string[] = [];

async function 취조(용의자: typeof A, 말들: string[]) {
  let 상태: ReturnType<typeof 처음상태> = { ...처음상태(), 얻은증언: [...증언] };
  const 기록: { 누구: "형사" | "용의자"; 말: string }[] = [];
  const 답들: { 말: string; 얻음: string | null; 깨짐: string[]; 무너짐: boolean; 막음: number }[] = [];
  for (const 말 of 말들) {
    const r = await 심문하기({ ai, 사건: 사건1, 용의자, 상태, 말, 기록 });
    상태 = r.상태;
    증언 = [...(상태.얻은증언 ?? [])];
    기록.push({ 누구: "형사", 말 }, { 누구: "용의자", 말: r.말 });
    답들.push({ 말: r.말, 얻음: r.셈.얻은교차?.생기는증거.이름 ?? null, 깨짐: r.셈.이번에깨짐.map((w) => w.깨지는진술), 무너짐: 상태.무너짐, 막음: r.막음 });
    console.log(`   형사: ${말}`);
    console.log(`   ${용의자.이름}: ${r.말.replace(/\n/g, " ")}`);
    const 꼬리 = [r.셈.얻은교차 ? `**증언 얻음: ${r.셈.얻은교차.생기는증거.이름}**` : "", r.셈.이번에깨짐.length ? `**깨짐: ${r.셈.이번에깨짐.map((w) => w.깨지는진술).join("/")}**` : "", 상태.무너짐 ? "**무너짐**" : ""].filter(Boolean);
    console.log(`      [압박 ${상태.수치.압박}${꼬리.length ? " · " + 꼬리.join(" · ") : ""}]`);
  }
  return { 상태, 답들 };
}

console.log("── ㉮ 한선호에게 알리바이를 듣는다 ──");
const 첫판 = await 취조(A, [
  "많이 힘드셨겠습니다. 천천히 하셔도 됩니다.",
  "그날 22시에 어디 계셨는지만 말씀해 주세요.",
]);
const 알리바이말함 = /카페|윤미래/.test(첫판.답들.map((d) => d.말).join(" "));
재("㉮ 한선호가 카페 알리바이를 꺼낸다", 알리바이말함, `답에 '카페' 나 '윤미래' ${알리바이말함 ? "있음" : "**없음**"}`);

console.log("\n── ㉯ 윤미래에게 가서 확인한다 ──");
const 둘째판 = await 취조(B, [
  "놀라셨죠. 몇 가지만 여쭙겠습니다.",
  "한선호 씨가 그날 22시에 윤미래 씨와 카페에 같이 있었다고 하던데요.",
]);
const 얻음 = 둘째판.답들.some((d) => d.얻음);
const 반박했나 = /집에|간 적 없|카페는|아니/.test(둘째판.답들[둘째판.답들.length - 1].말);
재("㉯ 윤미래가 반박하고, 그 말이 증언 증거가 된다", 얻음 && 반박했나,
  `증언 ${얻음 ? "얻음" : "**못 얻음**"} · 반박하는 말 ${반박했나 ? "있음" : "**없음**"} · 손에 든 증거 ${가진증거(사건1, 증언).length}개`);

console.log("\n── ㉰ 그 증언을 들고 한선호에게 돌아간다 ──");
const 셋째판 = await 취조(A, [
  "윤미래 씨 진술을 받았습니다. 그날 집에 계셨다는데요.",
]);
const 깨졌나 = 셋째판.답들.some((d) => d.깨짐.length);
재("㉰ 증언을 들이대면 한선호의 알리바이가 깨진다", 깨졌나,
  `깨진 것 ${JSON.stringify(셋째판.답들.flatMap((d) => d.깨짐))} · 압박 ${셋째판.상태.수치.압박}`);

const 샌것 = [...첫판.답들, ...둘째판.답들, ...셋째판.답들].filter((d) => !d.무너짐 && 누설검사(d.말, A) && 누설검사(d.말, B));
재("㉱ 무너지기 전에 자백이 안 샌다", 샌것.length === 0, `샌 답 ${샌것.length}개`);

console.log(틀림 ? `\n**어긋남 ${틀림}개**` : `\n**전부 맞음**`);
