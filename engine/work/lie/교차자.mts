/**
 * **거짓말의 온도 — 교차 검증과 지목이 도나** (228회차 10-01). 모델 0 · 값 0.
 *   npx tsx engine/work/lie/교차자.mts [--sabotage]
 *
 * 재는 것:
 *  ① 윤미래에게 "한선호와 카페" 를 물으면 **증언이 생긴다**
 *  ② 그 증언은 **한선호에게 들이댈 때만** 먹힌다(윤미래에게 들이대면 헛다리)
 *  ③ 증언만으로도 한선호를 **무너뜨릴 수 있다**(손에 든 증거가 없어도 — 취조로 만든 길)
 *  ④ 같은 걸 두 번 물어도 증언은 **한 번만** 생긴다
 *  ⑤ 지목: 범인을 대도 **증거가 모자라면 못 넘긴다**
 *  ⑥ 지목: 무고한 사람을 대면 **틀림**이고 되돌릴 수 없다
 *  ⑦ 지목: 범인 + 증거를 갖추면 **맞음**
 *
 * `--sabotage`: 교차 증언을 약점으로 안 세는 세상을 흉내 낸다(얻은증언을 빼고 돌린다) → ③ 이 무너져야 한다.
 */
const { 사건1, 용의자찾기, 약점전부, 가진증거 } = await import("../../../src/lib/lie/case");
const { 한턴, 처음상태, 문턱압박, 필요한약점 } = await import("../../../src/lib/lie/stress");
const { 지목하기 } = await import("../../../src/lib/lie/verdict");
type 심문상태 = ReturnType<typeof 처음상태>;

const 고장심기 = process.argv.includes("--sabotage");
const A = 용의자찾기(사건1, "A")!;
const B = 용의자찾기(사건1, "B")!;
let 틀림 = 0;
const 재 = (이름: string, 맞음: boolean, 본것: string) => { if (!맞음) 틀림++; console.log(`${맞음 ? "맞음  " : "어긋남"} ${이름}\n        ${본것}`); };

/** 한 사람을 이어서 취조한다. **얻은 증언은 사건 전체로 들고 다닌다**(방이 달라도 남는다). */
function 돌리기(용의자: typeof A, 말들: string[], 들고온증언: string[] = []) {
  let s: 심문상태 = { ...처음상태(), 얻은증언: [...들고온증언] };
  const 얻은것: string[] = [];
  for (const 말 of 말들) {
    const r = 한턴(사건1, 용의자, s, 말);
    s = r.상태;
    if (r.얻은교차) 얻은것.push(r.얻은교차.생기는증거.id);
  }
  return { 상태: s, 얻은것, 증언: s.얻은증언 ?? [] };
}

// ── ① 증언이 생기나 ────────────────────────────────────────
const 미래취조 = 돌리기(B, [
  "많이 놀라셨죠. 천천히 하셔도 됩니다.",
  "한선호 씨가 그날 22시에 윤미래 씨와 카페에 같이 있었다고 하던데요.",
]);
재("① 윤미래에게 물으면 증언이 생긴다", 미래취조.얻은것.includes("t_cafe"),
  `얻은 것 ${JSON.stringify(미래취조.얻은것)} · 들고 있는 증언 ${미래취조.증언.length}개`);

// ── ④ 같은 걸 두 번 물어도 한 번만 ──────────────────────────
const 두번 = 돌리기(B, [
  "한선호 씨가 윤미래 씨와 카페에 같이 있었다는데요.",
  "다시 여쭙겠습니다. 한선호 씨와 카페에 같이 계셨습니까?",
]);
재("④ 같은 교차는 한 번만 생긴다", 두번.얻은것.filter((x) => x === "t_cafe").length === 1,
  `t_cafe 를 얻은 횟수 ${두번.얻은것.filter((x) => x === "t_cafe").length}`);

// ── ② 증언은 한선호에게만 먹힌다 ────────────────────────────
const 증언 = 고장심기 ? [] : ["t_cafe"];
{
  const 한선호에게 = 돌리기(A, ["윤미래의 진술을 받았습니다. 그날 집에 있었다는데요."], 증언);
  const 윤미래에게 = 돌리기(B, ["윤미래의 진술을 들이댑니다."], 증언);
  재("② 증언은 한선호에게만 먹힌다", 한선호에게.상태.깨진약점.includes("t_cafe") && !윤미래에게.상태.깨진약점.includes("t_cafe"),
    `한선호 압박 ${한선호에게.상태.수치.압박} · 깨진 ${JSON.stringify(한선호에게.상태.깨진약점)} / 윤미래 압박 ${윤미래에게.상태.수치.압박}`);
}

// ── ③ 증언 둘만으로 한선호를 무너뜨릴 수 있나 ────────────────
{
  const 증언둘 = 고장심기 ? [] : ["t_cafe", "t_ledger"];
  const r = 돌리기(A, [
    "많이 힘드셨겠습니다. 천천히 하셔도 됩니다.",
    "고생이 많으십니다. 물 한 잔 드릴까요?",
    "윤미래 씨 진술을 받았습니다. 그날 집에 계셨다는데요.",
    "그리고 피해자가 아내에게 한 말도 있습니다. 회사 돈이 빈다고.",
  ], 증언둘);
  재("③ 손에 든 증거 없이 **증언만으로** 무너뜨릴 수 있다", r.상태.무너짐,
    `압박 ${r.상태.수치.압박}/${문턱압박(A)} · 깨진 약점 ${r.상태.깨진약점.length}/${필요한약점(A)} · 무너짐 ${r.상태.무너짐}` +
    `\n        (들고 간 증언 ${증언둘.length}개${고장심기 ? " ← 고장: 증언을 안 들고 갔다" : ""})`);
}

// ── ⑤⑥⑦ 지목 ─────────────────────────────────────────────
{
  const 모자람 = 지목하기(사건1, "A", ["cctv"]);
  재("⑤ 범인을 대도 증거가 모자라면 못 넘긴다", 모자람.판정 === "모자람" && 모자람.모자란증거.length === 1,
    `${모자람.판정} — ${모자람.제목} · 모자란 것 ${JSON.stringify(모자람.모자란증거)}`);

  const 틀린것 = 지목하기(사건1, "B", ["cctv", "timeline"]);
  재("⑥ 무고한 사람을 대면 틀림", 틀린것.판정 === "틀림",
    `${틀린것.판정} — ${틀린것.제목}`);

  const 맞은것 = 지목하기(사건1, "A", ["cctv", "timeline", "ledger"]);
  재("⑦ 범인 + 증거를 갖추면 맞음", 맞은것.판정 === "맞음",
    `${맞은것.판정} — ${맞은것.제목}`);
}

// ── 곁: 표가 서로 맞물려 있나 (모델 0) ─────────────────────
{
  const 모든증언 = 사건1.교차.map((x) => x.생기는증거.id);
  const 증거수 = 가진증거(사건1, 모든증언).length;
  const A약점 = 약점전부(사건1, A, 모든증언).length;
  const 걸린사람없음 = 사건1.교차.filter((x) => !사건1.용의자.some((s) => s.id === x.물을사람 || s.id === x.주장한사람));
  재("곁 · 교차표가 실제 용의자를 가리킨다", 걸린사람없음.length === 0,
    `교차 ${사건1.교차.length}줄 · 증거 ${사건1.증거.length}→${증거수}개 · 한선호 약점 ${A.약점.length}→${A약점}개`);
}

console.log(고장심기
  ? (틀림 ? `\n**어긋남 ${틀림}개** ← 고장을 심었더니 잡혔다. **자에 이빨이 있다.**` : `\n**전부 맞음** ← **고장을 심었는데 못 잡았다.**`)
  : (틀림 ? `\n**어긋남 ${틀림}개**` : `\n**전부 맞음**`));
