/**
 * **계기자 — 기계가 진실을 건드리지 않는가** (228회차 10-01, 세계관 ② 첫 조각). 모델 0 · 값 0.
 *   npx tsx engine/work/lie/계기자.mts
 *   npx tsx engine/work/lie/계기자.mts --sabotage
 *
 * 이 규칙에서 제일 무서운 고장은 눈금이 안 흔들리는 게 아니라 **기계가 진실을 바꾸는 것**이다.
 * 그러면 플레이어가 사람 대신 기계를 공략해서 이기는 게임이 되고, 그건 취조가 아니다.
 * 그래서 7개 중 셋(②④⑦)이 **"안 바뀌었나"** 를 잰다.
 */
const { 사건1, 용의자찾기 } = await import("../../../src/lib/lie/case");
const S = await import("../../../src/lib/lie/stress");

const 심기 = process.argv.includes("--sabotage");
const A = 용의자찾기(사건1, "A")!;
let 맞음 = 0, 쟨것 = 0;
const 재기 = (이름: string, 됐나: boolean, 적을것: string) => {
  쟨것++; if (됐나) 맞음++;
  console.log(`${됐나 ? "맞음  " : "**어긋남**"} ${이름}\n        ${적을것}`);
};

// 심은 고장: 계기가 진짜 압박을 깎게 만든다 — 기계를 망가뜨려 사람을 이기는 길이 열린다.
const 한턴 = (사건: any, 용: any, 앞: any, 말: string) => {
  const r = S.한턴(사건, 용, 앞, 말);
  if (심기) r.상태.수치.압박 = Math.max(0, r.상태.수치.압박 - Math.round((100 - (r.상태.계기 ?? 100)) / 4));
  return r;
};

// ── ① 처음엔 기계가 진실을 그대로 보여 준다 ──────────────────────
{
  const s = S.처음상태();
  재기("① 교정된 기계는 안 거짓말한다", S.보이는압박(s, "A") === s.수치.압박,
    `계기 ${S.계기신뢰도(s)} · 진짜 ${s.수치.압박} · 눈금 ${S.보이는압박(s, "A")}`);
}

// ── ② 쓰면 어긋나는데, **진실은 그대로다** ──────────────────────
{
  let s = S.처음상태();
  const 진짜: number[] = [], 눈금: number[] = [];
  for (let i = 0; i < 8; i++) { const r = 한턴(사건1, A, s, "그날 밤 어디 있었습니까"); s = r.상태; 진짜.push(s.수치.압박); 눈금.push(S.보이는압박(s, "A")); }
  const 벌어짐 = 눈금.map((v, i) => Math.abs(v - 진짜[i]));
  재기("② 턴이 쌓이면 눈금이 진짜에서 벌어진다", 벌어짐.some((d) => d >= 1),
    `계기 ${S.계기신뢰도(s)} · 진짜 ${진짜.join(",")} · 눈금 ${눈금.join(",")} · 최대 벌어짐 ${Math.max(...벌어짐)}`);

  // 같은 수를 **같은 말로 다시** 돌려서 진짜 압박이 똑같이 나오는지 — 기계가 진실에 손대면 여기서 갈린다.
  let t = S.처음상태();
  const 다시: number[] = [];
  for (let i = 0; i < 8; i++) { t = S.한턴(사건1, A, t, "그날 밤 어디 있었습니까").상태; 다시.push(t.수치.압박); }
  재기("③ 두 번 돌려도 진짜 압박은 같다(난수가 아니다)", 다시.join() === 진짜.join() || 심기,
    `첫판 ${진짜.join(",")} · 두번째 ${다시.join(",")}`);
}

// ── ④ 무너지는 자리는 **진짜 압박**이 정한다 ────────────────────
{
  // 계기를 바닥까지 떨어뜨려 놓고, 눈금이 뭐라 하든 문턱은 진짜 압박으로 걸리는지 본다.
  let s: any = { ...S.처음상태(), 계기: 0, 수치: { 압박: 79, 당황: 0, 분노: 0, 경계: 0 }, 깨진약점: ["ledger", "cctv"] };
  const 눈금 = S.보이는압박(s, "A");
  const r = 한턴(사건1, A, s, "부드럽게 다시 여쭙겠습니다");
  재기("④ 눈금이 뭐라 하든 무너짐은 진짜 압박이 정한다",
    (r.상태.수치.압박 >= S.문턱압박(A)) === r.상태.무너짐,
    `문턱 ${S.문턱압박(A)} · 들어가기 전 눈금 ${눈금}(진짜 79) · 뒤 진짜 ${r.상태.수치.압박} · 무너짐 ${r.상태.무너짐}`);
}

// ── ⑤ 분노·경계가 기계를 더 망가뜨린다 ────────────────────────
{
  let 조용 = S.처음상태(), 고함 = S.처음상태();
  for (let i = 0; i < 4; i++) {
    조용 = 한턴(사건1, A, 조용, "천천히 말씀해 주시죠").상태;
    고함 = 한턴(사건1, A, 고함, "거짓말하지 마! 당신이 죽인 거 다 알아!").상태;
  }
  재기("⑤ 몰아붙이면 기계가 더 빨리 망가진다", S.계기신뢰도(고함) < S.계기신뢰도(조용),
    `부드럽게 ${S.계기신뢰도(조용)} · 몰아붙여서 ${S.계기신뢰도(고함)} (분노 ${고함.수치.분노} · 경계 ${고함.수치.경계})`);
}

// ── ⑥ 재교정은 값을 치른다 ────────────────────────────────────
{
  let s = S.처음상태();
  for (let i = 0; i < 6; i++) s = 한턴(사건1, A, s, "거짓말하지 마! 다 알고 있어!").상태;
  const 앞계기 = S.계기신뢰도(s), 앞압박 = s.수치.압박;
  const t = S.기계재교정(s);
  재기("⑥ 재교정 — 기계는 돌아오고 상대는 숨을 돌린다",
    S.계기신뢰도(t) > 앞계기 && t.수치.압박 < 앞압박 && t.턴 === s.턴 + 1,
    `계기 ${앞계기}→${S.계기신뢰도(t)} · 압박 ${앞압박}→${t.수치.압박} · 턴 ${s.턴}→${t.턴}`);
}

// ── ⑦ 재교정이 진실을 **거저 주지 않는다** ──────────────────────
{
  // 재교정만 반복해서 무너뜨릴 수 있으면 그건 공짜 승리다. 20번 맞춰도 안 무너져야 한다.
  let s = S.처음상태();
  for (let i = 0; i < 20; i++) s = S.기계재교정(s);
  재기("⑦ 기계만 만져서는 아무도 안 무너진다", !s.무너짐 && s.수치.압박 <= 10,
    `20번 재교정 뒤 — 압박 ${s.수치.압박} · 무너짐 ${s.무너짐} · 계기 ${S.계기신뢰도(s)}`);
}

// ── ⑧ 등급 말이 수치와 어긋나지 않는다 ────────────────────────
{
  const 쌍: [number, string][] = [[100, "정상"], [70, "흔들림"], [45, "불안정"], [10, "신뢰불가"]];
  const 다맞나 = 쌍.every(([c, 등급]) => S.계기말({ ...S.처음상태(), 계기: c }).등급 === 등급);
  재기("⑧ 계기 등급이 수치를 따라간다", 다맞나,
    쌍.map(([c]) => `${c}→${S.계기말({ ...S.처음상태(), 계기: c }).등급}`).join(" · "));
}

console.log(`\n**${맞음}/${쟨것} 맞음**`);
if (심기) {
  console.log(맞음 === 쟨것
    ? "\n**자가 잠들어 있다** — 기계가 진짜 압박을 깎는데 아무 자도 안 울렸다."
    : `\n자가 깨어 있다 — 심은 고장(계기가 진짜 압박을 깎음)을 ${쟨것 - 맞음}개 자리에서 잡았다.`);
  if (맞음 === 쟨것) process.exitCode = 1;
} else if (맞음 < 쟨것) process.exitCode = 1;
