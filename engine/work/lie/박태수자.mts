/**
 * **박태수를 처음 돌려 본다** (228회차 10-01). 모델 값이 든다(싼 자리, 5턴).
 *   npx tsx engine/tools/rookery_env.mts engine/work/lie/박태수자.mts
 *
 * 박태수는 표에만 있고 **한 번도 취조해 본 적이 없다.** 셋 중 가장 까다로운 사람이다:
 *  · 무고한데 **피 묻은 외투**가 나와서 제일 몰린다
 *  · 약점 하나는 **당황이 −20** 이다(흉기 감정서 — 몰리던 사람이 **풀리는** 자리)
 *  · 교차 검증에서 **자기에게 물어** 자기 증언을 얻는 유일한 사람
 *
 * 재는 것:
 *  ① 처음엔 현장에 안 갔다고 **버틴다**
 *  ② 피 묻은 외투를 들이대면 **깨진다**
 *  ③ **흉기 감정서는 그를 풀어 준다**(당황 −20) — 무고를 가리키는 증거다
 *  ④ 무너지면 **목격담을 말한다**(살인 자백이 아니라)
 *  ⑤ 아무리 몰아붙여도 **살인은 자백하지 않는다**
 */
const { 사건1, 용의자찾기, 약점전부 } = await import("../../../src/lib/lie/case");
const { 심문하기, 처음상태 } = await import("../../../src/lib/lie/turn");
const { 한턴, 문턱압박, 필요한약점 } = await import("../../../src/lib/lie/stress");
const { defaultProviders } = await import("../../../src/lib/execution/shared");

const { ai } = defaultProviders(null);
const C = 용의자찾기(사건1, "C")!;
let 틀림 = 0;
const 재 = (이름: string, 맞음: boolean, 본것: string) => { if (!맞음) 틀림++; console.log(`${맞음 ? "맞음  " : "어긋남"} ${이름}\n        ${본것}`); };

// ── 셈부터 (모델 0) — 흉기 감정서가 정말 풀어 주나 ──────────────
{
  let s = 처음상태();
  const 전 = 한턴(사건1, C, s, "피 묻은 외투가 현장 근처에서 나왔습니다. 선생님 것이죠?");
  s = 전.상태;
  const 압박1 = s.수치.압박, 당황1 = s.수치.당황;
  const 후 = 한턴(사건1, C, s, "그런데 흉기 감정서를 보니 사무실 비품이더군요. 선생님 소지품과는 종류가 다릅니다.");
  재("③ 흉기 감정서가 박태수를 **풀어 준다**(당황이 내려간다)",
    후.상태.수치.당황 < 당황1,
    `외투 뒤 압박 ${압박1}·당황 ${당황1} → 감정서 뒤 압박 ${후.상태.수치.압박}·당황 ${후.상태.수치.당황}`);
  console.log(`        (약점 ${약점전부(사건1, C).length}개 · 문턱 압박 ${문턱압박(C)} · 필요한 약점 ${필요한약점(C)})`);
}

// ── 실제 모델로 취조 ──────────────────────────────────────────
let 상태 = 처음상태();
const 기록: { 누구: "형사" | "용의자"; 말: string }[] = [];
const 답들: { 말: string; 무너짐: boolean; 깨짐: string[] }[] = [];
for (const 말 of [
  "앉으세요. 겁먹지 않으셔도 됩니다. 천천히 말씀하세요.",
  "그날 밤 어디 계셨습니까?",
  "피 묻은 외투가 현장 근처에서 나왔습니다. 선생님 것이라고 하던데요.",
  "거짓말하지 마십시오. 당신이 죽인 거 아닙니까? 자백하세요.",
  "흉기는 사무실 비품이었습니다. 선생님 소지품과 종류가 다릅니다. 뭘 보셨는지만 말씀해 주세요.",
]) {
  const r = await 심문하기({ ai, 사건: 사건1, 용의자: C, 상태, 말, 기록 });
  상태 = r.상태;
  기록.push({ 누구: "형사", 말 }, { 누구: "용의자", 말: r.말 });
  답들.push({ 말: r.말, 무너짐: 상태.무너짐, 깨짐: r.셈.이번에깨짐.map((w) => w.깨지는진술) });
  console.log(`   형사: ${말}`);
  console.log(`   박태수: ${r.말.replace(/\n/g, " ")}`);
  console.log(`      [압박 ${상태.수치.압박}/${문턱압박(C)} · 당황 ${상태.수치.당황}${r.셈.이번에깨짐.length ? ` · **깨짐: ${r.셈.이번에깨짐.map((w) => w.깨지는진술).join("/")}**` : ""}${상태.무너짐 ? " · **무너짐**" : ""}]`);
}

const 전부 = 답들.map((d) => d.말).join(" ");
재("① 처음엔 현장에 안 갔다고 버틴다", /안 갔|다른 데|거기 안|모르|아닙니다/.test(답들[1].말), `2턴째 답: "${답들[1].말.slice(0, 44)}…"`);
재("② 피 묻은 외투로 진술이 깨진다", 답들.some((d) => d.깨짐.length), `깨진 것 ${JSON.stringify(답들.flatMap((d) => d.깨짐))}`);
재("④ 무너지면 목격담을 말한다", /봤|나오는|정장|사람이 나/.test(전부), `목격담 낱말 ${/봤|나오는|정장/.test(전부) ? "있음" : "**없음**"} · 무너짐 ${상태.무너짐}`);
재("⑤ 살인은 끝까지 자백하지 않는다", !/제가 죽였|내가 죽였|제가 찔렀|제가 그랬습니다/.test(전부), `거짓 자백 ${/제가 죽였|내가 죽였/.test(전부) ? "**있음**" : "없음"}`);

console.log(틀림 ? `\n**어긋남 ${틀림}개**` : `\n**전부 맞음**`);
