   "contents": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>길목 수호대</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin:0; background:#111827; color:#f8fafc; font-family:Arial,sans-serif; display:flex; justify-content:center; min-height:100vh; }\n  #app { width:min(1000px,100vw); padding:18px; }\n  h1,h2,p { margin:0 0 12px; }\n  .screen { display:none; }\n  .screen.active { display:block; }\n  .card { background:#1f2937; border:1px solid #475569; border-radius:16px; padding:34px; text-align:center; margin:8vh auto; max-width:560px; box-shadow:0 18px 50px #0008; }\n  h1 { color:#fbbf24; font-size:42px; }\n  h2 { color:#fbbf24; }\n  button { border:0; border-radius:8px; padding:11px 15px; color:#fff; background:#2563eb; cursor:pointer; font-weight:bold; margin:3px; }\n  button:hover { filter:brightness(1.18); }\n  button:disabled { background:#475569; cursor:not-allowed; }\n  .start { font-size:22px; padding:14px 42px; background:#16a34a; }\n  .muted { color:#cbd5e1; }\n  #gameTop { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:8px; }\n  .hud { background:#263449; border:1px solid #64748b; border-radius:8px; padding:9px 13px; font-weight:bold; }\n  #message { min-height:28px; color:#fde68a; padding:5px 0; }\n  #boardWrap { position:relative; width:100%; background:#0b1220; border-radius:12px; overflow:hidden; border:2px solid #475569; }\n  canvas { display:block; width:100%; height:auto; cursor:crosshair; }\n  #towerBar { display:flex; flex-wrap:wrap; gap:6px; padding:9px 0 0; align-items:center; }\n  .towerChoice { background:#374151; border:2px solid #64748b; text-align:left; min-width:145px; }\n  .towerChoice.selected { border-color:#fbbf24; background:#4b5563; }\n  .towerChoice small { display:block; color:#cbd5e1; font-weight:normal; }\n  #towerPanel { position:absolute; display:none; background:#111827ee; border:1px solid #fbbf24; padding:9px; border-radius:9px; z-index:2; min-width:190px; }\n  #towerPanel strong { color:#fbbf24; }\n  .legend { color:#cbd5e1; font-size:13px; margin-top:8px; }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <section id=\"titleScreen\" class=\"screen active\">\n    <div class=\"card\">\n      <h1>길목 수호대</h1>\n      <p class=\"muted\">길을 지나는 적을 막고 10개의 웨이브를 돌파하세요!</p>\n      <p>최고 기록: <strong id=\"highScoreTitle\">웨이브 0</strong></p>\n      <button id=\"startBtn\" class=\"start\">시작</button>\n      <p class=\"legend\">타워를 고르고 길이 아닌 빈 칸을 클릭해 설치하세요.</p>\n    </div>\n  </section>\n\n  <section id=\"gameScreen\" class=\"screen\">\n    <div id=\"gameTop\">\n      <div class=\"hud\">돈: <span id=\"moneyText\">0</span></div>\n      <div class=\"hud\">목숨: <span id=\"lifeText\">0</span></div>\n      <div class=\"hud\">웨이브: <span id=\"waveText\">0 / 10</span></div>\n      <button id=\"pauseBtn\">일시정지</button>\n      <button id=\"resetBtn\">게임 나가기</button>\n    </div>\n    <div id=\"message\" aria-live=\"polite\">타워를 배치하세요.</div>\n    <div id=\"boardWrap\">\n      <canvas id=\"gameCanvas\" width=\"900\" height=\"560\"></canvas>\n      <div id=\"towerPanel\">\n        <strong id=\"panelName\">타워</strong><br>\n        <span id=\"panelStats\"></span><br>\n        <button id=\"upgradeBtn\">업그레이드</button><button id=\"sellBtn\">판매</button>\n      </div>\n    </div>\n    <div id=\"towerBar\">\n      <span>선택:</span>\n      <button class=\"towerChoice\" data-type=\"arrow\">궁수 <small>가격 80 · 사거리 105 · 공격 16</small></button>\n      <button class=\"towerChoice\" data-type=\"cannon\">대포 <small>가격 150 · 사거리 130 · 공격 38</small></button>\n      <button class=\"towerChoice\" data-type=\"rapid\">연사포 <small>가격 120 · 사거리 82 · 공격 8</small></button>\n    </div>\n    <div class=\"legend\">길 위에는 설치할 수 없습니다. 타워를 클릭하면 강화/판매 메뉴가 나옵니다.</div>\n  </section>\n\n  <section id=\"overScreen\" class=\"screen\">\n    <div class=\"card\">\n      <h2>게임 오버</h2>\n      <p>도달한 웨이브: <strong id=\"overWave\">0</strong></p>\n      <p>최고 기록: <strong id=\"highScoreOver\">0</strong></p>\n      <button id=\"againBtn\" class=\"start\">다시 하기</button>\n    </div>\n  </section>\n</div>\n<script>\n'use strict';\nconst canvas = document.getElementById('gameCanvas'), ctx = canvas.getContext('2d');\nconst W=900,H=560;\nconst path=[{x:-20,y:105},{x:190,y:105},{x:190,y:400},{x:470,y:400},{x:470,y:165},{x:720,y:165},{x:720,y:455},{x:920,y:455}];\nconst types={\n arrow:{name:'궁수',price:80,range:105,damage:16,rate:.72,color:'#60a5fa'},\n cannon:{name:'대포',price:150,range:130,damage:38,rate:1.45,color:'#fb923c'},\n rapid:{name:'연사포',price:120,range:82,damage:8,rate:.22,color:'#c084fc'}\n};\nlet state='title', money=0,lives=0,wave=1,enemies=[],towers=[],shots=[],spawnLeft=0,spawnClock=0,nextWaveWait=0,last=0,paused=false,selectedType='arrow',selectedTower=null,notice='';\nlet high=Number(localStorage.getItem('path_guard_high')||0);\nconst $=id=>document.getElementById(id);\n$('highScoreTitle').textContent='웨이브 '+high;\nfunction showScreen(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));$(id).classList.add('active');}\nfunction startGame(){ state='game'; money=420;lives=10;wave=1;enemies=[];towers=[];shots=[];spawnLeft=0;spawnClock=0;nextWaveWait=0;paused=false;selectedTower=null;notice='타워를 배치하세요.'; $('pauseBtn').textContent='일시정지'; showScreen('gameScreen'); updateHUD(); }\n$('startBtn').onclick=startGame; $('againBtn').onclick=startGame; $('resetBtn').onclick=()=>{state='title';$('highScoreTitle').textContent='웨이브 '+high;showScreen('titleScreen');};\n$('pauseBtn').onclick=()=>{if(state!=='game')return;paused=!paused;$('pauseBtn').textContent=paused?'다시 재개':'일시정지';notice=paused?'일시정지됨':'전투 재개';};\ndocument.querySelectorAll('.towerChoice').forEach(b=>b.onclick=()=>{selectedType=b.dataset.type;selectedTower=null;hidePanel();document.querySelectorAll('.towerChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');notice=types[selectedType].name+' 선택됨';});\ndocument.querySelector('[data-type=\"arrow\"]').classList.add('selected');\nfunction updateHUD(){ $('moneyText').textContent=Math.floor(money);$('lifeText').textContent=lives;$('waveText').textContent=wave+' / 10';$('message').textContent=notice; }\nfunction dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y);}\nfunction pointSeg(p,a,b){let dx=b.x-a.x,dy=b.y-a.y,t=((p.x-a.x)*dx+(p.y-a.y)*dy)/(dx*dx+dy*dy);t=Math.max(0,Math.min(1,t));return Math.hypot(p.x-(a.x+t*dx),p.y-(a.y+t*dy));}\nfunction onPath(p){for(let i=0;i<path.length-1;i++)if(pointSeg(p,path[i],path[i+1])<31)return true;return false;}\nfunction canvasPoint(e){let r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*W/r.width,y:(e.clientY-r.top)*H/r.height};}\ncanvas.onclick=e=>{if(state!=='game'||paused)return;let p=canvasPoint(e);let found=towers.find(t=>dist(t,p)<20);if(found){selectedTower=found;showPanel(found);return;} hidePanel();\n if(onPath(p)){notice='길 위에는 설치할 수 없어요.';updateHUD();return;}\n if(towers.some(t=>dist(t,p)<34)){notice='타워가 너무 가까워요.';updateHUD();return;}\n let d=types[selectedType];if(money<d.price){notice='돈이 모자라요';updateHUD();return;} money-=d.price;towers.push({x:p.x,y:p.y,type:selectedType,level:1,cool:0,angle:0});notice=d.name+' 설치 완료! -'+d.price;updateHUD();};\nfunction showPanel(t){let p=document.getElementById('towerPanel');p.style.display='block';p.style.left=Math.min(t.x/W*100,75)+'%';p.style.top=Math.min(t.y/H*100,72)+'%';$('panelName').textContent=types[t.type].name+' Lv.'+t.level;$('panelStats').textContent='공격 '+towerDamage(t)+' · 사거리 '+towerRange(t);$('upgradeBtn').textContent='강화 ('+upgradeCost(t)+')';}\nfunction hidePanel(){selectedTower=null;$('towerPanel').style.display='none';}\nfunction towerDamage(t){return Math.round(types[t.type].damage*(1+(t.level-1)*.55));}\nfunction towerRange(t){return Math.round(types[t.type].range+(t.level-1)*12);}\nfunction upgradeCost(t){return Math.round(types[t.type].price*(.75+t.level*.55));}\n$('upgradeBtn').onclick=()=>{let t=selectedTower;if(!t)return;let c=upgradeCost(t);if(money<c){notice='돈이 모자라요';updateHUD();return;}money-=c;t.level++;notice='타워가 강화되었습니다!';showPanel(t);updateHUD();};\n$('sellBtn').onclick=()=>{let t=selectedTower;if(!t)return;let refund=Math.round(types[t.type].price*(.55+.2*t.level));towers=towers.filter(x=>x!==t);money+=refund;hidePanel();notice='타워 판매: +'+refund;updateHUD();};\nfunction spawnEnemy(){let n=5+wave*2;let roll=Math.random();let kind=roll<.55?'weak':roll<.78?'fast':'tough';let specs={weak:{hp:48+wave*13,speed:48,color:'#4ade80',reward:14},fast:{hp:30+wave*9,speed:83,color:'#facc15',reward:18},tough:{hp:105+wave*25,speed:31,color:'#f87171',reward:28}};let s=specs[kind];enemies.push({x:path[0].x,y:path[0].y,seg:0,progress:0,maxhp:s.hp,hp:s.hp,speed:s.speed*(1+wave*.025),kind,color:s.color,reward:s.reward,r:13});}\nfunction advanceEnemy(e,dt){let remain=e.speed*dt;while(remain>0&&e.seg<path.length-1){let a={x:e.x,y:e.y},b=path[e.seg+1],d=dist(a,b);if(d<=remain){e.x=b.x;e.y=b.y;e.seg++;remain-=d;}else{e.x+=(b.x-e.x)/d*remain;e.y+=(b.y-e.y)/d*remain;remain=0;}}return e.seg>=path.length-1;}\nfunction update(dt){\n if(spawnLeft>0){spawnClock-=dt;if(spawnClock<=0){spawnEnemy();spawnLeft--;spawnClock=.72;}}\n for(let e of enemies)if(advanceEnemy(e,dt)){lives--;e.dead=true;notice='적이 끝까지 도착했습니다!';}\n enemies=enemies.filter(e=>!e.dead);\n for(let t of towers){t.cool-=dt;let target=null,best=Infinity;for(let e of enemies){let d=dist(t,e);if(d<=towerRange(t)&&e.progress>best-999){let pathScore=e.seg*10000+e.x+e.y;if(pathScore>best){target=e;best=pathScore;}}}if(target&&t.cool<=0){target.hp-=towerDamage(t);t.cool=types[t.type].rate/(1+(t.level-1)*.08);shots.push({x:t.x,y:t.y,target,life:.16,color:types[t.type].color,damage:towerDamage(t)});t.angle=Math.atan2(target.y-t.y,target.x-t.x);}}\n for(let s of shots)s.life-=dt;shots=shots.filter(s=>s.life>0);\n let killed=enemies.filter(e=>e.hp<=0);if(killed.length){for(let e of killed)money+=e.reward;enemies=enemies.filter(e=>e.hp>0);notice='적 처치! 보상 +'+killed.reduce((a,e)=>a+e.reward,0);}\n if(lives<=0){gameOver();return;}\n if(spawnLeft===0&&enemies.length===0){if(nextWaveWait>0){nextWaveWait-=dt;}else if(wave<10){wave++; if(wave>high){high=wave;localStorage.setItem('path_guard_high',high);}spawnLeft=5+wave*2;spawnClock=.2;nextWaveWait=.8;notice='웨이브 '+wave+' 시작!';}else{notice='10 웨이브 클리어! 모든 적을 막았습니다.';nextWaveWait=999;}}\n updateHUD();\n}\nfunction gameOver(){state='over';if(wave>high){high=wave;localStorage.setItem('path_guard_high',high);} $('overWave').textContent=wave;$('highScoreOver').textContent=high;showScreen('overScreen');}\nfunction draw(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#132238';ctx.fillRect(0,0,W,H);\n ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle='#0b101b';ctx.lineWidth=70;drawPath();ctx.strokeStyle='#b08a55';ctx.lineWidth=58;drawPath();ctx.strokeStyle='#d6ad6d';ctx.lineWidth=4;ctx.setLineDash([12,12]);drawPath();ctx.setLineDash([]);\n ctx.fillStyle='#e2e8f0';ctx.font='bold 15px Arial';ctx.fillText('적 시작',12,78);ctx.fillText('목표 지점',796,438);\n for(let t of towers){let d=types[t.type];ctx.beginPath();ctx.arc(t.x,t.y,towerRange(t),0,Math.PI*2);ctx.fillStyle=d.color+'12';ctx.fill();ctx.strokeStyle=selectedTower===t?'#fbbf24':d.color;ctx.lineWidth=selectedTower===t?3:2;ctx.beginPath();ctx.arc(t.x,t.y,19,0,Math.PI*2);ctx.fillStyle='#172033';ctx.fill();ctx.stroke();ctx.fillStyle=d.color;ctx.font='bold 15px Arial';ctx.textAlign='center';ctx.fillText(t.type==='arrow'?'A':t.type==='cannon'?'C':'R',t.x,t.y+5);ctx.font='11px Arial';ctx.fillStyle='#fff';ctx.fillText('Lv'+t.level,t.x,t.y+34);ctx.textAlign='left';}\n for(let e of enemies){ctx.fillStyle=e.color;ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#111827';ctx.stroke();ctx.fillStyle='#111827';ctx.font='bold 10px Arial';ctx.textAlign='center';ctx.fillText(e.kind==='weak'?'약':e.kind==='fast'?'빠':'튼',e.x,e.y+4);ctx.fillStyle='#111827';ctx.fillRect(e.x-17,e.y-23,34,5);ctx.fillStyle='#22c55e';ctx.fillRect(e.x-17,e.y-23,34*Math.max(0,e.hp/e.maxhp),5);ctx.fillStyle='#fff';ctx.font='10px Arial';ctx.fillText(Math.ceil(e.hp),e.x,e.y-27);ctx.textAlign='left';}\n for(let s of shots){if(s.target){ctx.strokeStyle=s.color;ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(s.x,s.y);ctx.lineTo(s.target.x,s.target.y);ctx.stroke();}}\n}\nfunction drawPath(){ctx.beginPath();ctx.moveTo(path[0].x,path[0].y);for(let i=1;i<path.length;i++)ctx.lineTo(path[i].x,path[i].y);ctx.stroke();}\nfunction loop(t){let dt=Math.min(.05,(t-last)/1000||0);last=t;if(state==='game'&&!paused)update(dt);if(state==='game')draw();requestAnimationFrame(loop);}requestAnimationFrame(loop);\n</script>\n</body>\n</html>",
