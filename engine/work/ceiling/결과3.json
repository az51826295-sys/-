   "path": "index.html",
   "contents": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>길목 수호대 - 타워 디펜스</title>\n<style>\n*{box-sizing:border-box}body{margin:0;background:#101827;color:#eef4ff;font-family:Arial,\"Malgun Gothic\",sans-serif}button{font:inherit;cursor:pointer;border:0;border-radius:8px;color:#fff;background:#2563eb;padding:10px 16px;font-weight:700}button:hover{filter:brightness(1.15)}button:disabled{background:#475569;cursor:not-allowed;filter:none}.screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}.panel{width:min(1100px,100%);background:#172338;border:1px solid #33445f;border-radius:18px;box-shadow:0 18px 50px #0008;padding:24px}.title{text-align:center;max-width:650px}.title h1{font-size:48px;margin:10px 0;color:#7dd3fc}.title p{color:#cbd5e1;line-height:1.7}.big{font-size:22px;padding:14px 45px}.record{margin:22px auto;color:#facc15;font-size:20px}.hidden{display:none!important}.game-layout{display:grid;grid-template-columns:minmax(600px,1fr) 270px;gap:16px;align-items:start}.game-main{min-width:0}.hud{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;align-items:center}.stat{background:#243550;border-radius:8px;padding:9px 13px;font-size:16px}.stat b{color:#fef08a;font-size:19px}.hud .spacer{flex:1}.canvas-wrap{position:relative;background:#0b1220;border-radius:12px;overflow:hidden;border:2px solid #3b4b66}.canvas-wrap canvas{display:block;width:100%;height:auto}.side{background:#1f2d45;border-radius:12px;padding:16px}.side h2{font-size:19px;margin:0 0 12px}.tower-list{display:grid;gap:9px}.tower-btn{text-align:left;background:#2b3c58;padding:10px}.tower-btn.selected{outline:3px solid #facc15;background:#355274}.tower-btn .name{display:block;color:#bae6fd;font-size:17px}.tower-btn small{display:block;color:#d3dce9;line-height:1.45}.info{margin-top:14px;border-top:1px solid #49617e;padding-top:12px;color:#dbeafe;line-height:1.55;min-height:110px}.message{min-height:28px;color:#fbbf24;font-weight:bold;margin-top:10px}.help{font-size:13px;color:#aebed2;line-height:1.5}.over{text-align:center;max-width:600px}.over h1{font-size:48px;color:#fb7185}.over .wave-result{font-size:25px;color:#facc15;margin:20px}.legend{margin-top:8px;color:#b9c8dc;font-size:13px}@media(max-width:850px){.game-layout{grid-template-columns:1fr}.side{order:2}.panel{padding:12px}.title h1{font-size:36px}}\n</style>\n</head>\n<body>\n<section id=\"titleScreen\" class=\"screen\"><div class=\"panel title\"><h1>🛡️ 길목 수호대</h1><p>길을 따라 몰려오는 적을 막고 성을 지키세요.<br>타워를 배치하고 업그레이드해 10웨이브를 버티세요!</p><div class=\"record\">최고 웨이브: <b id=\"titleBest\">0</b></div><button id=\"startBtn\" class=\"big\">시작</button><p class=\"help\">외부 파일 없이 실행되는 오프라인 게임입니다.</p></div></section>\n<section id=\"gameScreen\" class=\"screen hidden\"><div class=\"panel\"><div class=\"game-layout\"><main class=\"game-main\"><div class=\"hud\"><div class=\"stat\">💰 돈 <b id=\"money\">150</b></div><div class=\"stat\">❤️ 목숨 <b id=\"lives\">20</b></div><div class=\"stat\">🌊 웨이브 <b id=\"wave\">1</b> / 10</div><div class=\"spacer\"></div><button id=\"pauseBtn\">일시정지</button></div><div class=\"canvas-wrap\"><canvas id=\"gameCanvas\" width=\"760\" height=\"500\"></canvas></div><div id=\"message\" class=\"message\"></div><div class=\"legend\">길 위에는 타워를 놓을 수 없습니다. 적을 클릭하면 체력 수치를 확인할 수 있습니다.</div></main><aside class=\"side\"><h2>타워 선택</h2><div id=\"towerList\" class=\"tower-list\"></div><div id=\"selectedInfo\" class=\"info\">타워를 선택한 뒤 빈 땅을 클릭하세요.</div><div class=\"help\">배치: 목록에서 타워 선택 → 캔버스의 빈 칸 클릭<br>업그레이드: 배치된 타워 클릭 → 업그레이드</div></aside></div></div></section>\n<section id=\"overScreen\" class=\"screen hidden\"><div class=\"panel over\"><h1>게임 오버</h1><div class=\"wave-result\">도달한 웨이브: <b id=\"overWave\">1</b></div><p>성의 목숨이 모두 소진되었습니다.</p><button id=\"restartBtn\" class=\"big\">다시 하기</button><p class=\"record\">최고 웨이브: <b id=\"overBest\">0</b></p></div></section>\n<script>\n'use strict';\nconst canvas=document.getElementById('gameCanvas'),ctx=canvas.getContext('2d');\nconst W=760,H=500;\nconst path=[{x:-25,y:90},{x:150,y:90},{x:150,y:250},{x:390,y:250},{x:390,y:110},{x:650,y:110},{x:650,y:390},{x:790,y:390}];\nconst towerTypes={\n arrow:{name:'화살 타워',price:45,range:115,damage:16,rate:.62,color:'#60a5fa',desc:'균형 잡힌 공격'},\n cannon:{name:'대포 타워',price:80,range:92,damage:42,rate:1.35,color:'#fb923c',desc:'느리지만 강한 공격'},\n frost:{name:'빙결 타워',price:65,range:130,damage:9,rate:.34,color:'#a5f3fc',desc:'빠른 연사 공격'}\n};\nlet game,selectedType='arrow',selectedTower=null,lastTime=0,raf=0;\nconst $=id=>document.getElementById(id);\nfunction best(){return Number(localStorage.getItem('towerBest')||0)}\nfunction setBest(n){if(n>best())localStorage.setItem('towerBest',n)}\nfunction show(screen){['titleScreen','gameScreen','overScreen'].forEach(id=>$(id).classList.toggle('hidden',id!==screen))}\nfunction initGame(){game={money:150,lives:20,wave:1,enemies:[],towers:[],shots:[],spawned:0,total:6,spawnTimer:0,nextWaveTimer:0,paused:false,over:false};selectedTower=null;selectedType='arrow';$('message').textContent='';renderTowerList();show('gameScreen');updateHud();lastTime=performance.now();cancelAnimationFrame(raf);raf=requestAnimationFrame(loop)}\nfunction renderTowerList(){let box=$('towerList');box.innerHTML='';for(const [id,t] of Object.entries(towerTypes)){let b=document.createElement('button');b.className='tower-btn'+(selectedType===id?' selected':'');b.innerHTML=`<span class=\"name\">${t.name} · ${t.price}💰</span><small>사거리 ${t.range} · 공격력 ${t.damage} · 연사 ${t.rate.toFixed(2)}초<br>${t.desc}</small>`;b.onclick=()=>{selectedType=id;selectedTower=null;renderTowerList();updateInfo()};box.appendChild(b)}}\nfunction updateHud(){$('money').textContent=game.money;$('lives').textContent=game.lives;$('wave').textContent=game.wave;$('pauseBtn').textContent=game.paused?'다시 시작':'일시정지'}\nfunction say(s){$('message').textContent=s;clearTimeout(say.timer);say.timer=setTimeout(()=>{$('message').textContent=''},2400)}\nfunction dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}\nfunction nearPath(x,y){for(let i=0;i<path.length-1;i++){let a=path[i],b=path[i+1],dx=b.x-a.x,dy=b.y-a.y,t=Math.max(0,Math.min(1,((x-a.x)*dx+(y-a.y)*dy)/(dx*dx+dy*dy)));if(Math.hypot(x-(a.x+t*dx),y-(a.y+t*dy))<34)return true}return false}\nfunction spawnEnemy(){let roll=(game.spawned+game.wave)%3;let type=roll===0?'fast':roll===1?'weak':'tank';let data={weak:{name:'약한 적',hp:42+game.wave*7,max:42+game.wave*7,speed:43,color:'#f87171',reward:12},fast:{name:'빠른 적',hp:27+game.wave*4,max:27+game.wave*4,speed:78,color:'#facc15',reward:16},tank:{name:'튼튼한 적',hp:105+game.wave*16,max:105+game.wave*16,speed:27,color:'#c084fc',reward:25}}[type];game.enemies.push({...data,type,x:path[0].x,y:path[0].y,seg:0,progress:0})}\nfunction update(dt){\n if(game.spawned<game.total){game.spawnTimer-=dt;if(game.spawnTimer<=0){spawnEnemy();game.spawned++;game.spawnTimer=.72}}\n for(let i=game.enemies.length-1;i>=0;i--){let e=game.enemies[i],remain=e.speed*dt;while(remain>0&&e.seg<path.length-1){let target=path[e.seg+1],d=dist(e,target),step=Math.min(remain,d);e.x+=(target.x-e.x)*step/d;e.y+=(target.y-e.y)*step/d;remain-=step;if(step>=d-.01)e.seg++}if(e.seg>=path.length-1){game.enemies.splice(i,1);game.lives--;updateHud();if(game.lives<=0){endGame();return}}}\n for(const t of game.towers){t.cool-=dt;if(t.cool<=0){let target=game.enemies.find(e=>dist(t,e)<=t.range);if(target){game.shots.push({x:t.x,y:t.y,target,damage:t.damage,color:t.color,life:1});t.cool=t.rate}}}\n for(let i=game.shots.length-1;i>=0;i--){let s=game.shots[i];if(!game.enemies.includes(s.target)){game.shots.splice(i,1);continue}let d=dist(s,s.target),step=370*dt;if(d<=step){s.target.hp-=s.damage;game.shots.splice(i,1);if(s.target.hp<=0){let k=game.enemies.indexOf(s.target);if(k>=0)game.enemies.splice(k,1);game.money+=s.target.reward;updateHud()}}else{s.x+=(s.target.x-s.x)*step/d;s.y+=(s.target.y-s.y)*step/d}}\n if(game.spawned>=game.total&&game.enemies.length===0){game.nextWaveTimer+=dt;if(game.wave<10&&game.nextWaveTimer>1.5){game.wave++;game.spawned=0;game.total=5+game.wave*2;game.nextWaveTimer=0;setBest(game.wave);say('웨이브 '+game.wave+' 시작! 적이 더 많고 강해졌습니다.');updateHud()}else if(game.wave===10&&game.nextWaveTimer>2){say('10웨이브 방어 성공!');game.nextWaveTimer=0}}\n}\nfunction loop(now){let dt=Math.min(.05,(now-lastTime)/1000);lastTime=now;if(!game.paused&&!game.over)update(dt);draw();if(!game.over)raf=requestAnimationFrame(loop)}\nfunction draw(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#172b2c';ctx.fillRect(0,0,W,H);ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle='#806b4d';ctx.lineWidth=66;pathDraw();ctx.strokeStyle='#c5a66a';ctx.lineWidth=49;pathDraw();ctx.strokeStyle='#ead39a';ctx.lineWidth=3;pathDraw();\n ctx.fillStyle='#fff';ctx.font='bold 13px Arial';ctx.fillText('적 출발',12,65);ctx.fillText('성',718,365);\n for(const t of game.towers){ctx.beginPath();ctx.fillStyle='#111827';ctx.arc(t.x,t.y,20,0,Math.PI*2);ctx.fill();ctx.strokeStyle=t.color;ctx.lineWidth=4;ctx.stroke();ctx.fillStyle='#e5e7eb';ctx.font='bold 12px Arial';ctx.textAlign='center';ctx.fillText(t.level,t.x,t.y+4);ctx.textAlign='left';if(t===selectedTower){ctx.beginPath();ctx.strokeStyle='#facc15';ctx.lineWidth=2;ctx.arc(t.x,t.y,t.range,0,Math.PI*2);ctx.stroke()}}\n for(const s of game.shots){ctx.fillStyle=s.color;ctx.beginPath();ctx.arc(s.x,s.y,5,0,Math.PI*2);ctx.fill()}\n for(const e of game.enemies){ctx.fillStyle=e.color;ctx.beginPath();ctx.arc(e.x,e.y,15,0,Math.PI*2);ctx.fill();ctx.fillStyle='#111827';ctx.font='bold 11px Arial';ctx.textAlign='center';ctx.fillText(e.type==='fast'?'빠':e.type==='tank'?'튼':'약',e.x,e.y+4);ctx.fillStyle='#111827';ctx.fillRect(e.x-20,e.y-25,40,5);ctx.fillStyle='#22c55e';ctx.fillRect(e.x-20,e.y-25,40*Math.max(0,e.hp/e.max),5);ctx.fillStyle='#fff';ctx.font='11px Arial';ctx.fillText(Math.ceil(e.hp),e.x,e.y-29);ctx.textAlign='left'}\n if(game.paused){ctx.fillStyle='#0009';ctx.fillRect(0,0,W,H);ctx.fillStyle='#fff';ctx.font='bold 38px Arial';ctx.textAlign='center';ctx.fillText('일시정지',W/2,H/2);ctx.textAlign='left'} }\nfunction pathDraw(){ctx.beginPath();ctx.moveTo(path[0].x,path[0].y);for(let i=1;i<path.length;i++)ctx.lineTo(path[i].x,path[i].y);ctx.stroke()}\nfunction updateInfo(){let info=$('selectedInfo');if(selectedTower){let t=selectedTower;info.innerHTML=`<b>${towerTypes[t.type].name} Lv.${t.level}</b><br>공격력: ${t.damage} · 사거리: ${t.range}<br>연사: ${t.rate.toFixed(2)}초<br><button id=\"upgradeBtn\">업그레이드 (${t.upgrade}💰)</button>`;$('upgradeBtn').onclick=upgrade}else info.innerHTML=`<b>${towerTypes[selectedType].name}</b><br>가격 ${towerTypes[selectedType].price} · 사거리 ${towerTypes[selectedType].range}<br>공격력 ${towerTypes[selectedType].damage} · 연사 ${towerTypes[selectedType].rate.toFixed(2)}초`}\nfunction upgrade(){let t=selectedTower;if(!t)return;if(game.money<t.upgrade){say('돈이 모자라요!');return}game.money-=t.upgrade;t.level++;t.damage=Math.round(t.damage*1.35);t.range+=10;t.upgrade+=35;updateHud();updateInfo();say('타워가 업그레이드되었습니다!')}\ncanvas.addEventListener('click',ev=>{if(game.paused)return;let r=canvas.getBoundingClientRect(),x=(ev.clientX-r.left)*W/r.width,y=(ev.clientY-r.top)*H/r.height;let old=game.towers.find(t=>dist(t,{x,y})<24);if(old){selectedTower=old;updateInfo();return}if(nearPath(x,y)){say('길 위에는 타워를 놓을 수 없어요.');return}let type=towerTypes[selectedType];if(game.money<type.price){say('돈이 모자라요!');return}game.money-=type.price;game.towers.push({x,y,type:selectedType,level:1,damage:type.damage,range:type.range,rate:type.rate,cool:0,upgrade:55,color:type.color});selectedTower=game.towers[game.towers.length-1];updateHud();updateInfo();say(type.name+' 배치 완료!')});\n$('startBtn').onclick=initGame;$('restartBtn').onclick=initGame;$('pauseBtn').onclick=()=>{game.paused=!game.paused;updateHud()};\nfunction endGame(){game.over=true;setBest(game.wave);$('overWave').textContent=game.wave;$('overBest').textContent=best();show('overScreen')}\n$('titleBest').textContent=best();renderTowerList();updateInfo();\n</script>\n</body>\n</html>",
   "language": "html"
  }
 ],
