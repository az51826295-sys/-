   "path": "index.html",
   "contents": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>2048 화살표 키 퍼즐</title>\n  <style>\n    :root {\n      --board: #bbada0;\n      --empty: rgba(238, 228, 218, 0.35);\n      --text: #776e65;\n      --light: #f9f6f2;\n      --accent: #8f7a66;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      padding: 24px;\n      color: var(--text);\n      background: #faf8ef;\n      font-family: Arial, Helvetica, sans-serif;\n    }\n\n    .game {\n      width: min(100%, 500px);\n    }\n\n    header {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 16px;\n      margin-bottom: 18px;\n    }\n\n    h1 {\n      margin: 0;\n      color: #776e65;\n      font-size: clamp(42px, 12vw, 68px);\n      line-height: 0.9;\n      letter-spacing: -4px;\n    }\n\n    .subtitle {\n      margin: 10px 0 0;\n      font-size: 14px;\n      line-height: 1.4;\n    }\n\n    .score-box {\n      min-width: 92px;\n      padding: 8px 14px 10px;\n      border-radius: 5px;\n      color: #eee4da;\n      background: #bbada0;\n      text-align: center;\n      font-weight: bold;\n      text-transform: uppercase;\n    }\n\n    .score-label {\n      display: block;\n      font-size: 11px;\n      letter-spacing: 1px;\n    }\n\n    #score {\n      display: block;\n      margin-top: 2px;\n      color: white;\n      font-size: 25px;\n      line-height: 1.1;\n    }\n\n    .controls {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 16px;\n      gap: 12px;\n    }\n\n    .help { margin: 0; font-size: 14px; }\n\n    button {\n      border: 0;\n      border-radius: 4px;\n      padding: 11px 15px;\n      color: white;\n      background: var(--accent);\n      cursor: pointer;\n      font-size: 14px;\n      font-weight: bold;\n    }\n\n    button:hover { background: #776452; }\n    button:focus-visible { outline: 3px solid #edc53f; outline-offset: 2px; }\n\n    .board {\n      position: relative;\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 12px;\n      padding: 12px;\n      border-radius: 6px;\n      background: var(--board);\n      aspect-ratio: 1;\n      user-select: none;\n    }\n\n    .cell {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 5px;\n      background: var(--empty);\n      color: var(--text);\n      font-size: clamp(25px, 8vw, 45px);\n      font-weight: bold;\n    }\n\n    .cell[data-value=\"2\"] { background: #eee4da; }\n    .cell[data-value=\"4\"] { background: #ede0c8; }\n    .cell[data-value=\"8\"] { background: #f2b179; color: #f9f6f2; }\n    .cell[data-value=\"16\"] { background: #f59563; color: #f9f6f2; }\n    .cell[data-value=\"32\"] { background: #f67c5f; color: #f9f6f2; }\n    .cell[data-value=\"64\"] { background: #f65e3b; color: #f9f6f2; }\n    .cell[data-value=\"128\"], .cell[data-value=\"256\"] { background: #edcf72; color: #f9f6f2; font-size: clamp(22px, 7vw, 38px); }\n    .cell[data-value=\"512\"], .cell[data-value=\"1024\"], .cell[data-value=\"2048\"] { background: #edc53f; color: #f9f6f2; font-size: clamp(19px, 6vw, 34px); }\n\n    .message {\n      min-height: 28px;\n      margin: 15px 0 0;\n      color: #776e65;\n      font-size: 20px;\n      font-weight: bold;\n      text-align: center;\n    }\n\n    @media (max-width: 420px) {\n      body { padding: 15px; }\n      .board { gap: 8px; padding: 8px; }\n      header { margin-bottom: 13px; }\n      .help { font-size: 12px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"game\">\n    <header>\n      <div>\n        <h1>2048</h1>\n        <p class=\"subtitle\">같은 숫자를 합쳐 2048을 만들어 보세요.</p>\n      </div>\n      <div class=\"score-box\" aria-label=\"점수\">\n        <span class=\"score-label\">점수</span>\n        <span id=\"score\">0</span>\n      </div>\n    </header>\n\n    <div class=\"controls\">\n      <p class=\"help\">화살표 키로 타일을 움직이세요.</p>\n      <button id=\"restart\" type=\"button\">다시 시작</button>\n    </div>\n\n    <section id=\"board\" class=\"board\" aria-label=\"2048 게임 보드\"></section>\n    <p id=\"message\" class=\"message\" role=\"status\" aria-live=\"polite\"></p>\n  </main>\n\n  <script>\n    (function () {\n      'use strict';\n\n      const SIZE = 4;\n      const boardElement = document.getElementById('board');\n      const scoreElement = document.getElementById('score');\n      const messageElement = document.getElementById('message');\n      const restartButton = document.getElementById('restart');\n      let board = [];\n      let score = 0;\n      let gameOver = false;\n\n      function makeEmptyBoard() {\n        return Array.from({ length: SIZE }, () => Array(SIZE).fill(0));\n      }\n\n      function draw() {\n        boardElement.innerHTML = '';\n        for (let row = 0; row < SIZE; row += 1) {\n          for (let col = 0; col < SIZE; col += 1) {\n            const cell = document.createElement('div');\n            const value = board[row][col];\n            cell.className = 'cell';\n            cell.dataset.value = value === 0 ? '' : String(value);\n            cell.textContent = value === 0 ? '' : String(value);\n            cell.setAttribute('aria-label', value === 0 ? '빈 칸' : String(value));\n            boardElement.appendChild(cell);\n          }\n        }\n        scoreElement.textContent = String(score);\n      }\n\n      function emptyCells() {\n        const cells = [];\n        for (let row = 0; row < SIZE; row += 1) {\n          for (let col = 0; col < SIZE; col += 1) {\n            if (board[row][col] === 0) cells.push({ row, col });\n          }\n        }\n        return cells;\n      }\n\n      function addRandomTile() {\n        const cells = emptyCells();\n        if (cells.length === 0) return false;\n        const spot = cells[Math.floor(Math.random() * cells.length)];\n        board[spot.row][spot.col] = Math.random() < 0.9 ? 2 : 4;\n        return true;\n      }\n\n      function startGame() {\n        board = makeEmptyBoard();\n        score = 0;\n        gameOver = false;\n        messageElement.textContent = '';\n        addRandomTile();\n        addRandomTile();\n        draw();\n      }\n\n      function slideLine(line) {\n        const compact = line.filter(value => value !== 0);\n        const result = [];\n        let gained = 0;\n        for (let i = 0; i < compact.length; i += 1) {\n          if (compact[i] === compact[i + 1]) {\n            const merged = compact[i] * 2;\n            result.push(merged);\n            gained += merged;\n            i += 1;\n          } else {\n            result.push(compact[i]);\n          }\n        }\n        while (result.length < SIZE) result.push(0);\n        return { line: result, gained: gained };\n      }\n\n      function getLine(index, direction) {\n        const line = [];\n        for (let offset = 0; offset < SIZE; offset += 1) {\n          if (direction === 'left') line.push(board[index][offset]);\n          if (direction === 'right') line.push(board[index][SIZE - 1 - offset]);\n          if (direction === 'up') line.push(board[offset][index]);\n          if (direction === 'down') line.push(board[SIZE - 1 - offset][index]);\n        }\n        return line;\n      }\n\n      function setLine(index, direction, line) {\n        for (let offset = 0; offset < SIZE; offset += 1) {\n          if (direction === 'left') board[index][offset] = line[offset];\n          if (direction === 'right') board[index][SIZE - 1 - offset] = line[offset];\n          if (direction === 'up') board[offset][index] = line[offset];\n          if (direction === 'down') board[SIZE - 1 - offset][index] = line[offset];\n        }\n      }\n\n      function canMove() {\n        if (emptyCells().length > 0) return true;\n        for (let row = 0; row < SIZE; row += 1) {\n          for (let col = 0; col < SIZE; col += 1) {\n            if (col < SIZE - 1 && board[row][col] === board[row][col + 1]) return true;\n            if (row < SIZE - 1 && board[row][col] === board[row + 1][col]) return true;\n          }\n        }\n        return false;\n      }\n\n      function move(direction) {\n        if (gameOver) return;\n        let changed = false;\n        let gainedThisMove = 0;\n\n        for (let index = 0; index < SIZE; index += 1) {\n          const oldLine = getLine(index, direction);\n          const processed = slideLine(oldLine);\n          if (processed.line.some((value, position) => value !== oldLine[position])) changed = true;\n          setLine(index, direction, processed.line);\n          gainedThisMove += processed.gained;\n        }\n\n        if (!changed) {\n          if (!canMove()) {\n            gameOver = true;\n            messageElement.textContent = '게임 오버';\n            draw();\n          }\n          return;\n        }\n\n        score += gainedThisMove;\n        addRandomTile();\n        draw();\n        if (!canMove()) {\n          gameOver = true;\n          messageElement.textContent = '게임 오버';\n        }\n      }\n\n      document.addEventListener('keydown', function (event) {\n        const directions = {\n          ArrowLeft: 'left',\n          ArrowRight: 'right',\n          ArrowUp: 'up',\n          ArrowDown: 'down'\n        };\n        if (directions[event.key]) {\n          event.preventDefault();\n          move(directions[event.key]);\n        }\n      });\n\n      restartButton.addEventListener('click', startGame);\n      startGame();\n    }());\n  </script>\n</body>\n</html>\n",
   "language": "html"
  }
 ],
