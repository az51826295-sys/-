# Rookery Alpha environment - copy to /etc/rookery/alpha.env and edit.
# This file holds a secret; chmod 600 and own it by the rookery user.
#   sudo install -o rookery -g rookery -m 600 \
#       deploy/rookery-alpha.env.example /etc/rookery/alpha.env

# --- required --------------------------------------------------------
# Anthropic API key. The engine cannot spend without it AND the gate.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
GENESIS_SPEND=i-approve

# Absolute path to the git clone the engine works on. It commits to
# rookery/* worktree branches under ROOKERY_WORK and pushes them; it
# never merges to an operating branch.
ROOKERY_REPO=/opt/rookery/repo

# Engine state (sqlite db, reports, logs) and disposable worktrees.
ROOKERY_DATA=/opt/rookery/data
ROOKERY_WORK=/opt/rookery/data/work

# --- token prices (CONFIRM against current pricing) ------------------
# USD per million tokens. The engine never guesses these; the daily
# report's cost and the budget reservations both use them. Values
# below are the Haiku figures the smoke used - verify before trusting
# the cost numbers.
ROOKERY_PRICE_IN=1.0
ROOKERY_PRICE_OUT=5.0
ROOKERY_USD_KRW=1400

# --- tunables (defaults shown) ---------------------------------------
ROOKERY_MODEL=claude-haiku-4-5-20251001
ROOKERY_BASE_BRANCH=main
ROOKERY_REMOTE=origin
ROOKERY_WORKERS=2
ROOKERY_MAX_TOKENS=4000
ROOKERY_TICK_SECONDS=300

# --- budget (KRW, defaults are the frozen spec) ----------------------
ROOKERY_MONTH_KRW=60000
ROOKERY_STOP_KRW=45000
ROOKERY_RESTRICT_KRW=40000
ROOKERY_WARN_KRW=35000
ROOKERY_DAILY_KRW=5000
ROOKERY_TASK_KRW=3000
ROOKERY_FIXED_KRW=15000

# --- Stage 1: multi-repo residency (optional) -------------------------
# Names of the upstream checkouts under ROOKERY_REPOS_ROOT/<name>_head
# (the same layout tools/live_run0.py and tools/intake_pipeline.py use).
# When set, ROOKERY_REPO is ignored and one engine + ledger runs per
# name at ROOKERY_DATA/ROOKERY_TAG/<name>/engine.db. Adopted branches
# stay local (no push to foreign repos); a human opens PRs.
#ROOKERY_REPOS=boltons,toolz,tinydb,marshmallow
#ROOKERY_REPOS_ROOT=/opt/rookery/genesis-project/data/repos
#ROOKERY_TAG=live_auto
#ROOKERY_LOCAL_ONLY_PR=1
# Periodic intake (seconds; 0 = off). Runs tools/intake_pipeline.py
# with the same tag - idempotent, so repeats are safe.
#ROOKERY_INTAKE_INTERVAL_S=86400
#ROOKERY_INTAKE_MOCK=0
# Batch mode: exit once every ledger is drained (or halted).
#ROOKERY_EXIT_WHEN_IDLE=0
