/**
 * **맨땅에서 실제로 몇 판·몇 분 걸리나** (10-11 사장님 "지금 좀 많이 어렵네").
 *   ASH_URL=... npx tsx engine/tools/ash_체감.mts [끝층=22]
 *
 * ash_막힘_시험 은 장비를 **넉넉히 주고** 잰다 — "장비가 있으면 넘는가" 를 보는 자다.
 * 이 자는 **아무것도 안 주고** 실제처럼 돌린다: 떨어진 재료로만 만들고, 모자라면 시장에서 산다.
 * 그래서 "10층을 넘기까지 **몇 판**, 실제로 **몇 분**" 이 나온다. 체감은 여기서 나온다.
 *
 * 한 판의 실제 시간은 게임의 턴 간격(420ms)과 장면 넘김으로 정해진다 — 그대로 곱해 적는다.
 */
import { openHeadless } from "../../src/lib/video/headless";
import { 이름헬퍼 } from "./ash_공통.mjs";
const 주소 = process.env.ASH_URL ?? "https://rookery-web-production.up.railway.app/ash/index.html";
const 끝층 = Number(process.argv[2] ?? 22);

const 창 = await openHeadless({ width: 390, height: 844 });
if (!창) process.exit(1);
try {
  const page = await 창.browser.newPage();
  await 이름헬퍼(page);
  await page.goto(주소, { waitUntil: "networkidle2", timeout: 60_000 });
  await new Promise((r) => setTimeout(r, 1800));

  const 본 = await page.evaluate((끝층: number) => {
    const w = window as any;
    for (let i = 1; i < 9999; i++) clearInterval(i);
    (window as any).requestAnimationFrame = () => 0;
    try { localStorage.clear(); } catch { /* 없어도 된다 */ }

    /* 맨땅 — 아무것도 안 심는다 */
    w.S.대원.length = 0; w.S.파티.length = 0;
    for (const k of ["기사", "검사", "회복술사"]) w.S.대원.push(w.대원만들기(k));
    w.S.파티 = w.S.대원.map((c: any) => c.id);
    w.S.가방.장비 = []; w.S.가방.약 = 0; w.S.약수 = 0;
    for (const k of Object.keys(w.재료이름)) w.S.가방[k] = 0;
    w.S.깸 = {}; w.S.보스깸 = []; w.S.금화 = 0; w.S.장날 = null; w.S.산것 = {};
    w.S.층 = 1; w.S.단계 = 1; w.S.사냥층 = 1; w.S.자동오름 = true; w.S.쉼 = 0;
    w.S.최고층 = w.열린층(); w.S.진행 = true;
    w.전투준비(); w.적만들기();

    /** 만들 수 있는 것은 다 만들고, 슬롯마다 가장 좋은 것을 낀다. 재료가 모자라면 **시장에서 산다.** */
    const 값 = (키: string) => Object.values(w.레시피[키].효과 ?? {}).reduce((a: number, b: any) => a + Number(b), 0);
    let 산것 = 0;
    const 꾸미기 = () => {
      /* **시장은 안 쓴다.** 이 자는 "순수하게 돌기만 했을 때" 의 바닥선을 잰다.
         시장은 하나 모자랄 때 구제하는 자리지 주 수급이 아니고, 자가 매 판 사 대면
         금화가 녹아 T2 를 영영 못 만든다(10-11 실측에서 이렇게 틀렸다).
         시장이 자물쇠를 푸는지는 ash_시장_시험 이 따로 본다. */
      for (const 슬롯 of ["무기", "갑옷", "장신구"]) {
        const 고를 = Object.keys(w.레시피)
          .filter((k) => w.레시피[k].슬롯 === 슬롯 && !w.모자람(k).length)
          .sort((a, b) => 값(b) - 값(a))[0];
        if (!고를) continue;
        for (const c of w.S.대원) {
          const 낀 = w.S.가방.장비.find((x: any) => x.누구 === c.id && w.레시피[x.키].슬롯 === 슬롯);
          /* 10-11 **하향 장착으로 재료를 태우고 있었다.**
             고르는 것이 "지금 만들 수 있는 것 중 최고"라, 강철갑옷을 하나 만들어 가죽이 20 아래로
             떨어지면 다음 턴엔 가죽갑옷이 최고가 되어 **도로 가죽갑옷을 만들어 입혔다.**
             그 왕복이 301판치 파편과 가죽을 전부 태웠고(남은 파편 20·가죽 12),
             자는 그걸 "재료가 모자라 T2 를 못 만든다"로 읽었다.
             **이미 낀 것보다 나을 때만** 만든다. */
          if (낀 && 값(낀.키) >= 값(고를)) continue;
          if (w.만들기(고를)) { const t = w.S.가방.장비[w.S.가방.장비.length - 1]; w.장착(t.id, c.id); }
        }
      }
    };

    const 길: any[] = [];
    let 턴 = 0, 층턴 = 0, 앞층 = 1, 층전멸 = 0, 판앞 = 0, 층판 = 0;
    let 막힌적 = 0, 막힌판 = 0, 되도전 = 0;
    let 지난도전장비 = "";
    let 벽층 = 0, 벽판앞 = 0, 벽판 = 0, 멈춤판 = 0, 못넘음 = false;
    const 재도전판: number[] = [];
    while (턴 < 900_000) {
      const 쉼앞 = w.S.쉼;
      w.한턴(); 턴++; 층턴++;
      if (w.S.쉼 > 쉼앞) 층전멸++;
      const 깸 = w.S.깸?.[w.S.층] ?? 0;
      if (깸 !== 판앞) { 판앞 = 깸; 층판++; 꾸미기(); }
      if (w.S.층 !== 앞층) {
        길.push({ 층: 앞층, 판: 층판, 전멸: 층전멸, 턴: 층턴 });
        앞층 = w.S.층; 층턴 = 0; 층전멸 = 0; 층판 = 0; 판앞 = w.S.깸?.[w.S.층] ?? 0;
        꾸미기();
        if (w.S.층 > 끝층) break;
      }
      /* **막혔다고 멈추지 않는다.** 실제 사람은 거기서 더 돌아 장비를 맞추고 다시 간다.
         그래서 "막힌 뒤 몇 판을 더 돌아야 넘는가" 까지 재야 진짜 체감이 나온다(10-11).
         장비를 더 낄 수 있게 되면 자동 등반을 다시 켜고 관문에 재도전한다. */
      if (!w.S.자동오름) {
        if (!막힌적) {
          막힌적 = 앞층 + 1; 길.push({ 층: 앞층 + 1, 판: 층판, 전멸: 층전멸, 턴: 층턴, 막힘: true });
          /* 10-11: 여기서 `지난도전장비` 를 빈 글자로 두고 "나아졌나"를 봤더니
             **내려가자마자 곧바로 다시 올라갔다**(빈 글자와는 늘 다르니까).
             막힌 그 순간의 장비를 기준으로 삼아야 "나아졌다"가 뜻을 가진다. */
          지난도전장비 = w.S.가방.장비.filter((x: any) => x.누구 != null).map((x: any) => x.키).sort().join();
        }
        막힌판++;
        /* **보스층으로 내려간다.** 핵심 재료(수호핵·이빨)는 **관문 보스만** 떨군다 —
           막힌 층에서 아무리 돌아도 안 나온다. 사람은 탑에서 그 층을 골라 들어가면 되지만,
           자는 그걸 해 줘야 실제 체감이 나온다(10-11 여기서 처음 드러났다). */
        if (막힌판 === 1) {
          const 아래보스 = Math.floor((막힌적 - 1) / 10) * 10;      // 20층에서 막혔으면 10층
          if (아래보스 >= 10) { w.S.층 = 아래보스; w.S.사냥층 = 아래보스;
            w.S.단계 = Math.floor((아래보스 - 1)/10) + 1; 벽층 = 아래보스; 벽판앞 = w.S.깸?.[아래보스] ?? 0;
            w.전투준비(); w.적만들기(); }
        }
        // 그 보스층을 **몇 판** 돌았는지 센다 — 사장님이 묻는 숫자가 턴이 아니라 판이다
        if (벽층) { const 깸2 = w.S.깸?.[벽층] ?? 0; if (깸2 !== 벽판앞) { 벽판앞 = 깸2; 벽판++; } }
        const 앞장비 = w.S.가방.장비.filter((x: any) => x.누구 != null).map((x: any) => x.키).sort().join();
        꾸미기();
        const 뒤장비 = w.S.가방.장비.filter((x: any) => x.누구 != null).map((x: any) => x.키).sort().join();
        /* **언제 다시 올라가나** — 10-11에 두 번 틀렸다.
           ① 조각 하나가 늘 때마다 올라갔다 → 넷 중 하나만 새 검을 든 채 또 졌다.
           ② "지금 만들 수 있는 게 없다"를 완비로 읽었다 → 재료가 떨어진 것뿐인데 올라가,
              같은 짓을 1,327번 되풀이했다.
           사람이 하는 것은 셋째다: **그 층에서 낄 수 있는 가장 좋은 것을 넷이 다 입을 때까지** 돈다.
           그래서 재료가 아니라 **목표 레시피**로 잰다. 그래도 안 차면 벽판 한도에서 포기한다. */
        /* **목표 레시피로 재는 것도 틀렸다**(10-11, 세 번째 시도).
           최고층 20 이면 목표가 엄니검(열림 20)이 되는데, 그 재료(이빨)는 **20층 보스만** 떨군다 —
           20층에 막혀 있으니 영영 못 찬다. 그래서 자는 301판을 돌고도 "덜 찼다"고 했다.
           사람이 하는 것은 간단하다: **더 좋아지지 않으면 그만 돌고 올라간다.** */
        if (뒤장비 !== 앞장비) 멈춤판 = 벽판;
        const 더나아질것없음 = 벽판 - 멈춤판 >= 20;
        if (더나아질것없음 && 뒤장비 !== 지난도전장비) {
          지난도전장비 = 뒤장비;
          // 더 만들 게 없다 → 막혔던 관문으로 돌아가 다시 간다
          재도전판.push(벽판); 벽판 = 0; 멈춤판 = 0; 막힌판 = 0;      // 막힌판을 되돌려야 다음에 또 내려간다
          w.S.층 = 막힌적; w.S.사냥층 = 막힌적; w.S.단계 = Math.floor((막힌적 - 1)/10) + 1;
          w.S.자동오름 = true; 되도전++; w.전투준비(); w.적만들기();
        }
        /* 벽판 한도 — 넷을 다 입히지 못한 채 오래 돌면 **그 벽은 너무 길다**는 뜻이다.
           숫자로 적고 멈춘다(끝없이 돌면 자가 영영 안 끝난다). */
        if (벽판 > 300) { 못넘음 = true; break; }
        if (막힌판 > 400_000) break;
      }
    }
    const 낀것 = w.S.가방.장비.filter((x: any) => x.누구 != null).map((x: any) => w.레시피[x.키].이름);
    return { 길, 턴, 닿은층: w.S.층, 막힘: !w.S.자동오름, 금화: w.S.금화, 산것, 낀것, 막힌적, 되도전, 재도전판, 벽판, 못넘음,
             최고층: w.S.최고층, 깸: { ...(w.S.깸 ?? {}) }, 보스깸: [...(w.S.보스깸 ?? [])],
             가방: Object.fromEntries(Object.keys(w.재료이름).map((k) => [k, w.S.가방[k] ?? 0])),
             거절: Object.fromEntries(Object.keys(w.레시피).map((k) => [k, w.모자람(k)])) };
  }, 끝층);

  const 초 = (턴: number) => (턴 * 0.15);   // 10-11: 턴 간격 420 → 150ms
  console.log(`\n맨땅에서 ${본.닿은층}층까지 — 총 ${본.턴}턴 ≈ **${(초(본.턴)/60).toFixed(0)}분**`
    + `${본.막힘 ? ` · **${본.닿은층}층에서 막힘**` : ""}`);
  console.log(`  시장에서 산 것 ${본.산것}번 · 남은 금화 ${본.금화}`
    + `${본.막힌적 ? ` · **${본.막힌적}층에서 한 번 막혔다가 ${본.되도전}번 다시 도전**` : ""}`);
  /* **벽 하나를 넘는 데 몇 판이 드는가** — 사장님이 묻는 숫자가 이것이다(10-11).
     "막혔다"와 "넘었다" 사이에 아래 보스층을 몇 판 돌았는지. */
  if (본.막힌적) {
    const 판들 = (본.재도전판 ?? []) as number[];
    console.log(판들.length
      ? `  ${본.막힌적}층 벽 — 아래 보스층을 **${판들.slice(0, 6).join("판 → ")}판** 돌고 넷을 다 입혀 올라갔다`
      : `  ${본.막힌적}층 벽 — **${본.벽판}판**을 돌고도 넷을 다 못 입혔다${본.못넘음 ? "(한도에서 멈춤)" : ""}`);
  }
  console.log(`  낀 장비: ${본.낀것.join(", ") || "없음"}`);
  /* 10-11: 자가 "301판 돌고도 T2 를 못 만들었다"고 했는데, **왜 거절당했는지는 안 적었다.**
     조사해 보니 게임은 멀쩡했다(같은 조건에서 30판에 만들어진다) — 자가 못 보고 있던 것이다.
     그래서 **거절 사유를 그대로 찍는다.** 0 은 "못 본다"일 수 있다. */
  console.log(`  최고층 ${본.최고층} · 가방 ${Object.entries(본.가방 as any).filter(([, v]: any) => (v as number) > 0).map(([k, v]) => `${k} ${v}`).join(" · ") || "(빔)"}`);
  for (const k of ["대검", "강철갑옷"])
    console.log(`  ${k} — ${((본.거절 as any)[k] ?? []).length ? `모자람 ${JSON.stringify((본.거절 as any)[k])}` : "**만들 수 있다**"}`);
  console.log("");
  console.log("   층    판   전멸     턴    분");
  let 누적 = 0;
  for (const r of 본.길 as any[]) {
    누적 += r.턴;
    if (r.층 % 5 === 0 || r.층 === 1 || r.막힘 || r.전멸 > 0)
      console.log(`  ${String(r.층).padStart(3)} ${String(r.판).padStart(5)} ${String(r.전멸).padStart(5)} ${String(r.턴).padStart(6)} ${(초(r.턴)/60).toFixed(1).padStart(6)}${r.막힘 ? "  ← 막힘" : ""}`);
  }
  console.log(`\n  10층까지 누적 ≈ ${(초((본.길 as any[]).filter((r) => r.층 <= 10).reduce((a, r) => a + r.턴, 0))/60).toFixed(0)}분`);
} finally { await 창.browser.close(); await 창.close?.(); }
