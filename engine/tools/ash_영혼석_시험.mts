/**
 * **영혼석이 설명대로 일하는가** (10-11). 모델 0 · 값 0.
 *   ASH_URL=http://127.0.0.1:8124/ash/index.html npx tsx engine/tools/ash_영혼석_시험.mts [--sabotage]
 *
 * 영혼석은 **수치를 올리는 것이 아니라 기술을 바꾸는 것**이라 글만 보면 다 맞아 보인다.
 * 그래서 바뀐 쪽이 **실제로 다르게 때리는지**를 숫자로 잰다:
 *   · 끼우면 바뀌고 **빼면 돌아오는가**(이게 안 되면 영혼석이 아니라 그냥 상향이다)
 *   · 혈의 축복이 정말 체력을 태우고 배율이 1.2 → 1.4 가 되는가
 *   · 영혼 반전이 적 보호막을 가져와 아군 막으로 바꾸는가
 *   · 재기가 **한 판에 한 번만** 살리는가
 *   · 별가루가 50 → 75 가 되는가 · 신속이 첫 턴 쿨을 줄이는가
 *   · 드롭이 관문 보스에서만, 18% 언저리로 나오는가
 *
 * `ash_살았나.mts` 를 **먼저** 돌려라 — 이 자는 한턴()을 손으로 돌린다.
 */
import { openHeadless } from "../../src/lib/video/headless";
import { 이름헬퍼 } from "./ash_공통.mjs";
const 주소 = process.env.ASH_URL ?? "https://rookery-web-production.up.railway.app/ash/index.html";
let 나쁨 = 0;
const 재기자 = (n: string, ok: boolean, 본?: unknown) => { if (!ok) 나쁨++; console.log(ok ? "통과" : "실패", n, ok ? "" : JSON.stringify(본)); };

const 창 = await openHeadless({ width: 390, height: 844, protocolTimeout: 20 * 60_000 });
if (!창) process.exit(1);
try {
  const page = await 창.browser.newPage();
  await 이름헬퍼(page);
  await page.goto(주소, { waitUntil: "networkidle2", timeout: 60_000 });
  await new Promise((r) => setTimeout(r, 1800));

  if (process.argv.includes("--sabotage")) await page.evaluate(() => {
    /* 심은 고장: **영혼석을 껴도 기술이 안 바뀐다.** 글도 드롭도 그대로라 눈으로는 안 보인다. */
    const w = window as any;
    w.기술키 = (_c: any, k: string) => k;
  });

  const 본 = await page.evaluate(() => {
    const w = window as any;
    for (let i = 1; i < 9999; i++) clearInterval(i);
    w.requestAnimationFrame = () => 0;
    try { localStorage.clear(); } catch { /* */ }
    let 씨 = 20261011; Math.random = () => { 씨 = (씨 * 1103515245 + 12345) & 0x7fffffff; return 씨 / 0x7fffffff; };

    const 가짐 = (ks: string[]) => { w.S.영혼석 = { 가진: Object.fromEntries(ks.map((k) => [k, 1])), 낀액티브: [], 낀패시브: null }; };
    const 끼움 = (k: string) => {
      const d = w.영혼석표[k];
      if (d.종류 === "액티브") { if (!w.S.영혼석.낀액티브.includes(k)) w.S.영혼석.낀액티브.push(k); }
      else w.S.영혼석.낀패시브 = k;
    };
    const 뺌 = (k: string) => {
      const d = w.영혼석표[k];
      if (d.종류 === "액티브") w.S.영혼석.낀액티브 = w.S.영혼석.낀액티브.filter((x: string) => x !== k);
      else w.S.영혼석.낀패시브 = null;
    };

    /* ① 표가 명세대로 생겼나 */
    const 표 = Object.entries(w.영혼석표).map(([k, d]: any) => ({ 키: k, 종류: d.종류, 주인: d.주인 ?? null }));

    /* ② **끼우면 바뀌고 빼면 돌아온다** — 기술키()를 게임의 식 그대로 부른다 */
    for (const k of ["검사", "전투사제", "흑마법사"]) if (!w.S.대원.some((c: any) => c.키 === k)) w.S.대원.push(w.대원만들기(k, 30));
    const 검 = w.S.대원.find((c: any) => c.키 === "검사");
    const 로제 = w.S.대원.find((c: any) => c.키 === "전투사제");
    const 칼 = w.S.대원.find((c: any) => c.키 === "흑마법사");
    가짐(["폭풍", "혈", "역천"]);
    const 갈림: any = { 뺀채: {}, 낀채: {}, 다시뺀: {} };
    갈림.뺀채 = { 검: w.기술키(검, "연속베기"), 로제: w.기술키(로제, "성스러운축복"), 칼: w.기술키(칼, "사슬") };
    for (const k of ["폭풍", "혈", "역천"]) 끼움(k);
    갈림.낀채 = { 검: w.기술키(검, "연속베기"), 로제: w.기술키(로제, "성스러운축복"), 칼: w.기술키(칼, "사슬") };
    // **남의 기술은 안 건드린다** — 폭풍이 끼어 있어도 로제의 기도는 그대로여야 한다
    갈림.남 = w.기술키(로제, "기도");
    for (const k of ["폭풍", "혈", "역천"]) 뺌(k);
    갈림.다시뺀 = { 검: w.기술키(검, "연속베기"), 로제: w.기술키(로제, "성스러운축복"), 칼: w.기술키(칼, "사슬") };

    /* ③ 혈의 축복 — 체력을 태우고 배율이 1.4 가 되는가 */
    가짐(["혈"]); 끼움("혈");
    w.S.파티 = [검, 로제, 칼].map((c: any) => c.id);
    w.S.최고층 = 20; w.S.층 = 20; w.S.진행 = true; w.전투준비(); w.적만들기(0);
    const 체앞 = 로제.hp, 공앞 = w.공격력(검);
    w.기술표["혈의축복"].쓰기(로제);
    const 혈 = { 체앞, 체뒤: 로제.hp, 최대: w.최대체력(로제), 배: 검.축복배값 ?? null, 공앞, 공뒤: w.공격력(검) };

    /* ④ 영혼 반전 — 보스 보호막을 가져와 아군 막으로 */
    가짐(["역천"]); 끼움("역천");
    w.S.최고층 = 40; w.S.층 = 40; w.전투준비(); w.적만들기(0);   // 40층은 보호막 층
    const 적 = (w.적들 ?? [])[0];
    const 반전 = { 막앞: 적?.보호막 ?? 0, 아군막앞: 검.막 };
    if (적?.보호막 > 0) w.기술표["영혼반전"].쓰기(칼);
    Object.assign(반전, { 막뒤: (w.적들 ?? [])[0]?.보호막 ?? 0, 아군막뒤: 검.막 });

    /* ⑤ 재기 — 한 판에 한 번만 */
    가짐(["재기"]); 끼움("재기");
    w.S.최고층 = 20; w.S.층 = 20; w.전투준비(); w.적만들기(0);
    const 큰 = w.최대체력(검) * 99;
    const 한번 = w.아군맞기(검, 큰);
    const 두번 = w.아군맞기(검, 큰);
    const 재기본 = { 첫: 한번.재기 ?? 0, 둘: 두번.재기 ?? 0, 몫: (한번.재기 ?? 0) / w.최대체력(검), hp: 검.hp };
    뺌("재기");
    w.전투준비();
    const 없이 = w.아군맞기(검, 큰);
    const 재기없음 = 없이.재기 ?? 0;

    /* ⑥ 신속 — 첫 턴 쿨이 줄어 있는가 */
    가짐(["신속"]); 끼움("신속");
    w.S.층 = 20; w.전투준비();
    const 신속쿨 = { ...(검.쿨표 ?? {}) };
    뺌("신속"); w.전투준비();
    const 맨쿨 = { ...(검.쿨표 ?? {}) };

    /* ⑦ 별가루 50 → 75 · 드롭이 관문에서만, 18% 언저리로 */
    const 별 = { 켬: null as any, 끔: null as any };
    for (const [이름, 석] of [["끔", null], ["켬", "별빛"]] as any[]) {
      가짐(석 ? [석] : []); if (석) 끼움(석);
      w.S.최고층 = 20; w.S.층 = 20; w.S.깸 = { 20: 5 }; w.S.보스깸 = [20];
      const 앞 = w.S.가방.별가루 ?? 0;
      w.S.진행 = true; w.전투준비(); w.적만들기(0);
      for (const e of w.적들) e.hp = -1;                       // 보스를 눕힌 상태로 판끝을 부른다
      w.판끝();
      별[이름] = (w.S.가방.별가루 ?? 0) - 앞;
    }

    /* 드롭 — 관문 1,000판 · 보통 층 1,000판 */
    const 센다 = (보스층: boolean) => {
      let 떨 = 0;
      for (let i = 0; i < 1000; i++) {
        w.S.영혼석 = { 가진:{}, 낀액티브:[], 낀패시브:null };
        w.S.최고층 = 99; w.S.층 = 보스층 ? 20 : 19; w.S.깸 = { [w.S.층]: 9 }; w.S.보스깸 = [10, 20];
        w.S.무리 = 0; w.S.무리수 = 1;
        w.S.진행 = true; w.전투준비(); w.적만들기(0);
        for (const e of w.적들) e.hp = -1;
        w.판끝();
        if (Object.keys(w.S.영혼석.가진).length) 떨++;
      }
      return 떨;
    };
    const 드롭 = { 관문: 센다(true), 보통: 센다(false) };

    return { 표, 갈림, 혈, 반전, 재기본, 재기없음, 신속쿨, 맨쿨, 별, 드롭 };
  });

  console.log(`  표 — ${본.표.map((r: any) => `${r.키}(${r.종류}${r.주인 ? `·${r.주인}` : ""})`).join(" · ")}`);
  console.log(`  혈 — 체력 ${본.혈.체앞} → ${본.혈.체뒤} (최대 ${본.혈.최대}) · 배 ${본.혈.배} · 공격 ${본.혈.공앞} → ${본.혈.공뒤}`);
  console.log(`  반전 — 적 보호막 ${본.반전.막앞} → ${본.반전.막뒤} · 아군 막 ${본.반전.아군막앞} → ${본.반전.아군막뒤}`);
  console.log(`  드롭 — 관문 ${본.드롭.관문}/1000 · 보통 층 ${본.드롭.보통}/1000`);
  console.log(`  별가루 — 끄면 ${본.별.끔} · 켜면 ${본.별.켬}\n`);

  재기자("영혼석이 여섯이고 액티브 셋·패시브 셋이다",
    본.표.length === 6 && 본.표.filter((r: any) => r.종류 === "액티브").length === 3, 본.표);

  /* **이 자의 심장** — 끼우면 바뀌고 빼면 돌아온다 */
  재기자("끼우면 기술이 바뀐다",
    본.갈림.낀채.검 === "관통폭풍참" && 본.갈림.낀채.로제 === "혈의축복" && 본.갈림.낀채.칼 === "영혼반전", 본.갈림);
  재기자("빼면 원래 기술로 돌아온다",
    본.갈림.다시뺀.검 === "연속베기" && 본.갈림.다시뺀.로제 === "성스러운축복" && 본.갈림.다시뺀.칼 === "사슬", 본.갈림);
  재기자("남의 기술은 안 건드린다", 본.갈림.남 === "기도", { 기도: 본.갈림.남 });

  재기자("혈의 축복이 체력을 10% 태운다",
    Math.abs((본.혈.체앞 - 본.혈.체뒤) / 본.혈.최대 - 0.1) < 0.02, 본.혈);
  재기자("혈의 축복이 공격을 40% 올린다(1.2 → 1.4)",
    본.혈.배 === 1.4 && Math.abs(본.혈.공뒤 / 본.혈.공앞 - 1.4) < 0.03, 본.혈);

  재기자("영혼 반전이 적 보호막을 끊는다", 본.반전.막앞 > 0 && 본.반전.막뒤 === 0, 본.반전);
  재기자("그만큼이 아군 막으로 간다", 본.반전.아군막뒤 > 본.반전.아군막앞, 본.반전);

  재기자("재기가 쓰러질 피해에서 10%로 살린다",
    본.재기본.첫 > 0 && Math.abs(본.재기본.몫 - 0.1) < 0.02, 본.재기본);
  재기자("재기는 한 판에 한 번뿐이다", 본.재기본.둘 === 0, 본.재기본);
  재기자("영혼석을 빼면 재기가 안 걸린다", 본.재기없음 === 0, { 재기없음: 본.재기없음 });

  const 쿨값 = (o: any) => Object.values(o ?? {}) as number[];
  재기자("신속이 첫 턴 쿨을 1 줄여 놓는다",
    쿨값(본.신속쿨).length > 0 && 쿨값(본.신속쿨).every((v) => v === -1) && 쿨값(본.맨쿨).every((v) => v !== -1),
    { 신속: 본.신속쿨, 맨: 본.맨쿨 });

  재기자("찬란한 별가루가 50 → 75", 본.별.끔 === 50 && 본.별.켬 === 75, 본.별);

  재기자("영혼석은 관문 보스에서만 떨어진다", 본.드롭.보통 === 0, 본.드롭);
  재기자("드롭이 18% 언저리다", 본.드롭.관문 >= 130 && 본.드롭.관문 <= 230, 본.드롭);
} finally { await 창.browser.close(); await 창.close?.(); }
console.log(나쁨 === 0 ? "전부 통과" : `실패 ${나쁨}건`);
process.exit(나쁨 === 0 ? 0 : 1);
