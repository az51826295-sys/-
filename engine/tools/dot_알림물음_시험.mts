/**
 * **알림을 묻는 때가 맞나** (10-12). 모델 0 · 값 0.
 *   npx tsx engine/tools/dot_알림물음_시험.mts [--sabotage]
 *
 * 쓴 사람 18명 중 알림을 켠 사람이 **0명**이라, 메뉴에 있던 것을 대화 안으로 꺼냈다.
 * 꺼내는 순간 **새 위험**이 생긴다 — 아무 때나 들이밀면 알림을 켜기는커녕 앱을 끈다.
 * 화면은 로그인해야 보여 자가 못 도니, **묻는 때를 정하는 판단**만 떼어 여기서 잰다.
 *
 * 제품 코드를 그대로 불러 쓴다(베껴 적지 않는다 — 베끼면 코드가 바뀌어도 자는 옛 답을 맞다고 한다).
 */
/* 10-12: 처음엔 `src/app/dot/[slug]/` 에 뒀다 — 판단은 화면이 아니라 규칙이므로 `src/lib/dot/` 이 제자리다.
   그리고 **정적 `import` 로는 안 불린다**("does not provide an export named"). 이 저장소의 다른 자들이
   전부 `await import(...)` 를 쓰는 까닭이 이것이다. 같은 길로 맞춘다. */
const { 물어볼까, 물어볼턴 } = await import("../../src/lib/dot/pushAsk");

let 나쁨 = 0;
const 재기 = (n: string, ok: boolean, 본?: unknown) => { if (!ok) 나쁨++; console.log(ok ? "통과" : "실패", n, ok ? "" : JSON.stringify(본)); };
/* `as const` 로 두면 타입이 "off" 로 굳어 다른 상태를 못 넣는다 — 보기마다 갈아 끼우는 게 이 자의 일이다 */
type 안 = Parameters<typeof 물어볼까>[0];
const 기본: 안 = { 로그인: true, 알림: "off", 내가건말: 물어볼턴, 전에물음: false, 이미띄움: false };
const 보기 = (바꿀: Partial<안>): 안 => ({ ...기본, ...바꿀 });

console.log(`물어볼턴 = ${물어볼턴}\n`);

/* 물어야 하는 때 — 하나뿐이다 */
재기("몇 마디 나눈 뒤, 아직 안 켠 사람에게는 묻는다", 물어볼까(기본) === true, 기본);

/* 물으면 안 되는 때 — **여기가 이 자의 심장이다.** 하나라도 새면 사람을 잃는다 */
재기("첫 줄부터 들이밀지 않는다", 물어볼까(보기({ 내가건말: 1 })) === false);
재기(`${물어볼턴}턴을 채우기 전엔 안 묻는다`, 물어볼까(보기({ 내가건말: 물어볼턴 - 1 })) === false);
재기("**이미 켠 사람에게는 안 묻는다**", 물어볼까(보기({ 알림: "on" })) === false);
재기("브라우저가 막은 사람에게는 안 묻는다(막힌 걸 또 눌러도 안 열린다)", 물어볼까(보기({ 알림: "denied" })) === false);
재기("알림을 못 쓰는 기기에서는 안 묻는다", 물어볼까(보기({ 알림: "unsupported" })) === false);
재기("알림 상태를 아직 모를 때는 안 묻는다", 물어볼까(보기({ 알림: null })) === false);
재기("**한 번 물었으면 다시 안 묻는다**", 물어볼까(보기({ 전에물음: true })) === false);
재기("이미 떠 있으면 또 켜지 않는다", 물어볼까(보기({ 이미띄움: true })) === false);
재기("로그인 안 한 사람에게는 안 묻는다", 물어볼까(보기({ 로그인: false })) === false);

/* 많이 말한 사람에게도 물어야 한다(턴이 넘쳐도 켜져야 한다) */
재기("많이 말한 사람에게도 묻는다", 물어볼까(보기({ 내가건말: 200 })) === true);

if (process.argv.includes("--sabotage")) {
  /* 심은 고장: "한 번만" 을 잊은 판. 거절한 사람에게 또 묻는 것이 가장 흔한 사고다. */
  /* 10-12: 처음 심은 고장은 `알림 === "off"` 를 봤다 — 그래서 "이미 켠 사람" 을 **우연히 맞게**
     처리해 버려 셋 중 둘만 걸렸다. 자가 침묵하면 자보다 **심은 것**을 먼저 의심한다(09-21).
     제대로 심는다: 못 쓰는 기기만 빼고 **한 번만·이미 켬·이미 띄움을 전부 잊은** 판. */
  const 고장난 = (안: 안) =>
    안.로그인 && 안.내가건말 >= 물어볼턴 && 안.알림 !== "unsupported" && 안.알림 !== "denied" && 안.알림 !== null;
  console.log("\n[--sabotage] '한 번만' 과 '이미 켠 사람' 을 잊은 판으로 바꿔 센다");
  const 잡힘 = [보기({ 전에물음: true }), 보기({ 알림: "on" }), 보기({ 이미띄움: true })]
    .filter((c) => 고장난(c) !== 물어볼까(c)).length;
  console.log(잡힘 === 3 ? "통과 심은 고장 3개를 자가 전부 갈라낸다(이빨 있다)" : `실패 3개 중 ${잡힘}개만 갈라낸다`);
  if (잡힘 !== 3) 나쁨++;
}

console.log(나쁨 === 0 ? "\n전부 통과" : `\n실패 ${나쁨}건`);
process.exit(나쁨 === 0 ? 0 : 1);
