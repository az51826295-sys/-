/**
 * **SR 동료 둘이 설명대로 일하는가** (10-11). 모델 0 · 값 0.
 *   ASH_URL='http://127.0.0.1:8124/ash/index.html?lang=ko' npx tsx engine/tools/ash_SR_시험.mts [--sabotage]
 *
 * 로건·이브가 들고 온 **새 칸이 다섯 개**다 — 진형·약화·불굴·출혈·치명 보정.
 * 전부 카드 설명에 숫자로 적혀 있으므로, 그 숫자가 **실제로 그 값인지**를 잰다.
 * (10-11 교훈: 설명과 코드가 어긋나면 사장님은 거짓말을 믿고 편성을 짠다.)
 *
 * 어떻게 재나 — **손으로 상태를 심지 않는다.** 진짜 전투를 돌려 놓고
 *   · 기술이 남긴 **글줄**로 "일어났나"를 보고
 *   · `방어력(c)` 같은 **게임의 함수**로 "얼마나"를 본다.
 * 심어서 재면 기술이 죽어 있어도 통과한다(10-09 에 실제로 그랬다).
 *
 * `ash_살았나.mts` 를 **먼저** 돌려라. 이 자는 한턴() 을 손으로 돌리므로,
 * 게임이 죽어 있어도 여기까지는 굴러간다.
 */
import { openHeadless } from "../../src/lib/video/headless";
import { 이름헬퍼 } from "./ash_공통.mjs";
const 주소 = process.env.ASH_URL ?? "https://rookery-web-production.up.railway.app/ash/index.html?lang=ko";
let 나쁨 = 0;
const 재기 = (n: string, ok: boolean, 본?: unknown) => { if (!ok) 나쁨++; console.log(ok ? "통과" : "실패", n, ok ? "" : JSON.stringify(본)); };

const 창 = await openHeadless({ width: 390, height: 844 });
if (!창) process.exit(1);
try {
  const page = await 창.browser.newPage();
  await page.setViewport({ width: 390, height: 844, deviceScaleFactor: 2 });
  await 이름헬퍼(page);
  await page.goto(주소, { waitUntil: "networkidle2", timeout: 60_000 });
  await new Promise((r) => setTimeout(r, 1800));

  if (process.argv.includes("--sabotage")) await page.evaluate(() => {
    /* 심은 고장 — **진형이 방어를 안 올린다.** 글줄은 그대로 나오므로,
       글만 세는 자는 이걸 못 잡는다. 그게 이 스위치를 두는 이유다. */
    const w = window as any, 원 = w.기술표["성역의진형"].쓰기;
    w.기술표["성역의진형"].쓰기 = (c: any) => { 원(c); for (const t of w.산아군?.() ?? []) t.진형 = 0; };
  });

  const 본 = await page.evaluate(() => {
    const w = window as any;
    for (let i = 1; i < 9999; i++) clearInterval(i);
    try { localStorage.clear(); } catch { /* 없어도 된다 */ }
    // 난수를 묶는다 — 치명타·약화 20% 는 운이라, 안 묶으면 판마다 판정이 흔들린다
    let 씨 = 20261011;
    Math.random = () => { 씨 = (씨 * 1103515245 + 12345) & 0x7fffffff; return 씨 / 0x7fffffff; };
    w.requestAnimationFrame = () => 0;

    for (const k of ["성기사", "암살자"]) if (!w.S.대원.some((c: any) => c.키 === k)) w.S.대원.push(w.대원만들기(k, 1));
    const 파 = ["기사", "성기사", "암살자", "회복술사"].map((k) => w.S.대원.find((c: any) => c.키 === k));
    w.S.파티 = 파.map((c: any) => c.id);
    const 로건 = 파[1], 이브 = 파[2];

    /* 보스층에서 오래 싸운다 — 쿨 4짜리 기술이 두 번은 돌아야 하고,
       로건이 30% 아래로 떨어져야 「불굴의 의지」가 나온다. */
    w.S.최고층 = 20; w.S.층 = 20; w.S.사냥층 = 20; w.S.탭 = "run"; w.S.진행 = true;
    for (const c of 파) c.레벨 = 14;
    w.전투준비(); w.적만들기(0);

    const 글 = (document.querySelector("#log") ?? document.body) as HTMLElement;
    const 본글: string[] = [];
    const 쓸어담기 = () => { const t = 글.innerText ?? ""; if (t) 본글.push(t); };

    /* 진형이 선 턴과 안 선 턴의 **방어력**을 게임의 함수로 직접 읽는다 */
    let 진형앞 = 0, 진형뒤 = 0;
    let 약화본: any = null, 출혈본: any = null;
    const 밑방어 = w.방어력(로건);
    /* 10-11 자 고침: 끝값을 재면 **판이 끝나고 체력이 다시 찬 뒤**를 본다 —
       첫 판에서 체력비 1 이 나와 「불굴의 의지」가 통째로 안 재졌다.
       버티는 것을 재려면 **가장 낮았던 때**를 세야 한다. */
    let 최저 = 1;
    /* 같은 이유로 `불굴씀` 플래그도 **끝에서 읽으면 안 된다** — 한 판 짜리 표시라
       다음 층 전투준비가 지워 놓는다. 켜지는 **순간을 센다**. */
    let 불굴켜짐 = 0, 앞불굴 = false;

    for (let i = 0; i < 2400; i++) {
      w.한턴();
      최저 = Math.min(최저, Math.max(0, 로건.hp) / w.최대체력(로건));
      if (로건.불굴씀 && !앞불굴) 불굴켜짐++;
      앞불굴 = !!로건.불굴씀;
      if (로건.진형 > 0 && !진형뒤) 진형뒤 = w.방어력(로건);
      if (!(로건.진형 > 0) && !진형앞) 진형앞 = w.방어력(로건);
      for (const e of w.적들 ?? []) {
        if (e.약화남음 > 0 && !약화본) 약화본 = { 약화: e.약화, 남음: e.약화남음, 원공격: e.공격, 먹은공격: w.적공격(e) };
        if (e.출혈남음 > 0 && !출혈본) 출혈본 = { 남음: e.출혈남음, 피해: e.출혈피해, 치명: w.치명확률(이브, e), 밑치명: w.치명확률(이브, { 출혈남음: 0 }) };
      }
      쓸어담기();
      if (!w.S.진행) break;
    }
    const 합 = 본글.join("\n");
    return {
      합있나: 합.length > 0,
      진형글: 합.includes("성역의 진형"),
      진형앞, 진형뒤, 밑방어,
      약화글: 합.includes("공격 −10%"),
      약화본,
      출혈글: 합.includes("상처가 벌어졌다"),
      출혈본,
      불굴글: 합.includes("무릎을 꿇지 않았다"),
      최저체력비: 최저,
      불굴켜짐,
      습격글: 합.includes("그림자에서 덮쳤다"),
      급소글: 합.includes("급소를 베었다"),
      // 전투 사이에 버프가 넘어가지 않는가 — 전투준비가 칸을 지우는지
      준비뒤: (() => { 로건.진형 = 3; 로건.불굴씀 = true; w.전투준비(); return { 진형: 로건.진형, 불굴씀: 로건.불굴씀 }; })(),
    };
  });

  console.log(`  로건 방어 — 밑 ${본.밑방어} · 진형 밖 ${본.진형앞} · 진형 안 ${본.진형뒤}`);
  console.log(`  약화 ${JSON.stringify(본.약화본)}`);
  console.log(`  출혈 ${JSON.stringify(본.출혈본)}\n`);

  재기("전투가 실제로 돌았다(글이 쌓였다)", 본.합있나 && 본.급소글 && 본.습격글, { 급소: 본.급소글, 습격: 본.습격글 });

  /* ① 성역의 진형 — 글만이 아니라 **방어가 35% 오르는가** */
  재기("로건이 성역의 진형을 편다", 본.진형글, 본.진형글);
  재기("진형 중 방어가 35% 오른다",
    본.진형앞 > 0 && 본.진형뒤 > 0 && Math.abs(본.진형뒤 / 본.진형앞 - 1.35) < 0.02,
    { 앞: 본.진형앞, 뒤: 본.진형뒤, 배: 본.진형앞 ? +(본.진형뒤 / 본.진형앞).toFixed(3) : null });

  /* ② 방패 치기의 약화 — 적 공격력이 **실제로 10% 깎여 먹히는가** */
  재기("방패 치기가 적 공격력을 깎는다", !!본.약화본 && 본.약화본.약화 === 0.10, 본.약화본);
  재기("깎인 공격력이 실제로 먹힌다",
    !!본.약화본 && Math.abs(본.약화본.먹은공격 / 본.약화본.원공격 - 0.9) < 0.001, 본.약화본);

  /* ③ 불굴의 의지 — 30% 아래로 떨어진 뒤 한 번 */
  재기("로건이 30% 아래로 떨어졌다(재 볼 수 있다)", 본.최저체력비 <= 0.3 || 본.불굴켜짐 > 0,
    { 체력비: +본.최저체력비.toFixed(3), 켜짐: 본.불굴켜짐 });
  if (본.최저체력비 <= 0.3 || 본.불굴켜짐 > 0)
    재기("불굴의 의지가 터진다", 본.불굴글 && 본.불굴켜짐 > 0, { 글: 본.불굴글, 켜짐: 본.불굴켜짐 });

  /* ④ 출혈 — 턴마다 갉고, 부패의 저주와 **칸이 다른가** */
  재기("그림자 습격이 출혈을 남긴다", !!본.출혈본 && 본.출혈본.남음 > 0 && 본.출혈본.피해 > 0, 본.출혈본);
  재기("출혈이 턴마다 갉는다", 본.출혈글, 본.출혈글);

  /* ⑤ 맹독 바르기 — 출혈 중인 적에게 치명 +15% */
  재기("출혈 중인 적에게 치명이 15% 더 붙는다",
    !!본.출혈본 && Math.abs(본.출혈본.치명 - 본.출혈본.밑치명 - 0.15) < 0.001, 본.출혈본);

  /* ⑥ 전투준비가 버프 칸을 지우는가 — 안 지우면 다음 층이 공짜로 두꺼워진다 */
  재기("전투준비가 진형·불굴을 되돌린다", 본.준비뒤.진형 === 0 && 본.준비뒤.불굴씀 === false, 본.준비뒤);
} finally { await 창.browser.close(); await 창.close?.(); }
console.log(나쁨 === 0 ? "전부 통과" : `실패 ${나쁨}건`);
process.exit(나쁨 === 0 ? 0 : 1);
