/**
 * **앱 아이콘 후보 2판 — 얼굴을 안 쓴다** (227회차 09-29, 사장님 "아니 아예 다른걸로"). 값 0 · 모델 0.
 *
 *   npx tsx engine/tools/dot_icon_ideas2.mts
 *
 * 1판은 전부 캐릭터 얼굴을 바탕만 바꿔 얹은 것이었다. 사장님이 "아예 다른 것" 이라고 하셨으니
 * **얼굴을 뺀다.** 이름에서 뽑는다 — **두근**(심장이 뛰는 것) + **도트**(픽셀).
 *
 * 아이콘에서 지키는 것:
 *  · **글자 없음** — 폰에서 아이콘은 엄지손톱만 하다.
 *  · **모양 하나** — 두 개를 넣으면 작아져서 둘 다 안 보인다.
 *  · **안전 원 안(가운데 66%)** — 안드로이드가 바깥을 자른다. 만든 뒤 잰다.
 *  · **도트 격자로만** — 16칸 격자에서 그려 정수배로 키운다. 부드러운 곡선은 도트가 아니다.
 */
import sharp from "sharp";
import { writeFileSync, mkdirSync } from "node:fs";

const OUT = "C:/Users/az518/Desktop/두근도트-아이콘후보2";
mkdirSync(OUT, { recursive: true });
const S = 512, 칸 = 16;
type 색 = { r: number; g: number; b: number };
const 노랑: 색 = { r: 254, g: 229, b: 0 };
const 분홍: 색 = { r: 255, g: 92, b: 122 };
const 진분홍: 색 = { r: 214, g: 51, b: 82 };
const 흰: 색 = { r: 255, g: 255, b: 255 };
const 먹: 색 = { r: 28, g: 28, b: 28 };
const 남: 색 = { r: 31, g: 41, b: 61 };

/**
 * 16칸 그림을 **안전 원 안에** 넣는다.
 *
 * 첫 판은 16칸을 그대로 512 로 늘렸다 — 그러니 하트가 칸을 꽉 채워 **34~41% 가 안전 원 밖**이었고,
 * 안드로이드가 그만큼 잘라 낸다. 모양을 칸의 {@link 속비율} 만큼으로 줄여 가운데 둔다.
 */
const 속비율 = 0.62;
async function 그리기(줄: string[], 팔레트: Record<string, 색>, 바탕: 색): Promise<Buffer> {
  const buf = Buffer.alloc(칸 * 칸 * 4);
  for (let y = 0; y < 칸; y++) for (let x = 0; x < 칸; x++) {
    const ch = (줄[y] ?? "")[x] ?? ".";
    const c = 팔레트[ch];
    const p = (y * 칸 + x) * 4;
    if (c) { buf[p] = c.r; buf[p + 1] = c.g; buf[p + 2] = c.b; buf[p + 3] = 255; }   // 모양만, 바탕은 투명
  }
  const 속 = Math.round(S * 속비율);
  const 모양 = await sharp(buf, { raw: { width: 칸, height: 칸, channels: 4 } })
    .resize(속, 속, { kernel: "nearest" }).png().toBuffer();
  return sharp({ create: { width: S, height: S, channels: 4, background: { ...바탕, alpha: 1 } } })
    .composite([{ input: 모양, left: Math.round((S - 속) / 2), top: Math.round((S - 속) / 2) }])
    .png().toBuffer();
}

/** 모양이 안전 원 밖으로 얼마나 나가나. **줄인 뒤 기준**으로 센다 — 줄이기 전 값은 화면과 다르다. */
function 재기(줄: string[]): string {
  let n = 0, 밖 = 0;
  const c = (칸 - 1) / 2, r = (칸 * 0.33) / 속비율;     // 모양이 작아진 만큼 원이 커진 셈
  for (let y = 0; y < 칸; y++) for (let x = 0; x < 칸; x++) {
    if (((줄[y] ?? "")[x] ?? ".") === ".") continue;
    n++; if (Math.hypot(x - c, y - c) > r) 밖++;
  }
  return n ? `${((밖 / n) * 100).toFixed(0)}%` : "—";
}

// ── 모양들 ────────────────────────────────────────────────────
const 하트 = [
  "................",
  "................",
  "...###....###...",
  "..#####..#####..",
  ".###############",
  ".###############",
  ".###############",
  ".###############",
  "..#############.",
  "...###########..",
  "....#########...",
  ".....#######....",
  "......#####.....",
  ".......###......",
  "........#.......",
  "................",
];

/** 점으로만 이루어진 하트 — 이름 그대로 **도트**. 한 칸씩 띄운다. */
const 점하트 = 하트.map((줄, y) => [...줄].map((ch, x) => (ch === "#" && (x + y) % 2 === 0 ? "#" : ".")).join(""));

/** 심장이 뛰는 선. 가운데에서 한 번 튄다. */
const 박동 = [
  "................",
  "................",
  "................",
  "................",
  "................",
  "......#.........",
  "......#.........",
  "......#..#......",
  "####..#..#..####",
  "...#.#...#.#....",
  "...#.#...#.#....",
  "....##....#.....",
  "................",
  "................",
  "................",
  "................",
];

/** 말풍선 하나 — 채팅앱이라는 뜻. 안은 비운다(모양 하나 원칙). */
const 말풍선 = [
  "................",
  "................",
  "..############..",
  ".##############.",
  ".##############.",
  ".##############.",
  ".##############.",
  ".##############.",
  ".##############.",
  ".##############.",
  "..############..",
  "...##...........",
  "...##...........",
  "..##............",
  "................",
  "................",
];
/** 말풍선 안에 하트를 판 것 — 구멍이라 색이 하나 더 안 든다. */
const 말풍선하트 = 말풍선.map((줄, y) => {
  const 안 = ["................", "................", "................", "................",
    "......@@..@@....", ".....@@@@@@@@...", ".....@@@@@@@@...", ".....@@@@@@@@...",
    "......@@@@@@....", ".......@@@@.....", "........@@......", "................",
    "................", "................", "................", "................"][y] ?? "";
  return [...줄].map((ch, x) => (안[x] === "@" ? "@" : ch)).join("");
});

const 후보: [string, string, string[], Record<string, 색>, 색][] = [
  ["A-하트", "픽셀 하트 하나. 제일 단순하고 제일 또렷하다.", 하트, { "#": 분홍 }, 노랑],
  ["B-점하트", "하트를 **점으로만** 찍었다 — 이름 그대로 '두근 + 도트'.", 점하트, { "#": 분홍 }, 노랑],
  ["C-박동선", "심장이 뛰는 선. '두근' 을 그림 하나로 말한다.", 박동, { "#": 진분홍 }, 노랑],
  ["D-말풍선하트", "말풍선 안에 하트를 팠다. 채팅 + 설렘이 한 모양에 들어간다.", 말풍선하트, { "#": 흰, "@": 분홍 }, 분홍],
  ["E-하트밤하늘", "밤 배경에 분홍 하트. 밤에 쓰는 앱이라는 결.", 하트, { "#": 분홍 }, 남],
  ["F-하트먹테", "하트에 먹색 테를 둘렀다. 흰 배경 화면에서도 안 묻힌다.",
    하트.map((줄, y) => [...줄].map((ch, x) => {
      if (ch === "#") {
        const 가 = [[-1, 0], [1, 0], [0, -1], [0, 1]].some(([dx, dy]) => ((하트[y + dy] ?? "")[x + dx] ?? ".") === ".");
        return 가 ? "o" : "#";
      }
      return ".";
    }).join("")), { "#": 분홍, o: 먹 }, 노랑],
];

console.log("얼굴을 안 쓴 후보 (글자 없음 · 모양 하나).\n");
for (const [이름, 설명, 줄, 팔, 바탕] of 후보) {
  const png = await 그리기(줄, 팔, 바탕);
  const p = `${OUT}/${이름}.png`;
  writeFileSync(p, png);
  console.log(`${이름.padEnd(12)} 안전원 밖 ${재기(줄).padStart(4)}  ${설명}`);
}
console.log(`\n→ ${OUT}`);
