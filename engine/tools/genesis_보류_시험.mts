/**
 * **"못 잼" 이 기각이 아니라 보류로 가나** (10-12). 모델 0 · 값 0.
 *   npx tsx engine/tools/rookery_env.mts engine/tools/genesis_보류_시험.mts [--sabotage]
 *
 * 실측: 규칙 후보 85개 중 **78%** 가 "어긴 사례 3건 미만" 으로 죽었다
 * (판정까지 가서 46% · 제안 단계에서 32%). 통계 문(lift·p)에서 죽은 것은 6% 뿐이다.
 * 그런데 "판단 불가" 는 **틀렸다는 뜻이 아니라 아직 못 쟀다는 뜻**이다 —
 * 기각해 버리면 다음 달에 그 종류의 판이 쌓여도 그 규칙은 이미 죽어 있다.
 *
 * 그래서 판정을 셋으로 갈랐다(채택·기각·못잼). **숫자를 보기 전에 셈이 도는지 먼저 돌려 본다**
 * (09-21 사장님 규칙: 가짜 판 기록으로 모든 조건이 값을 내는지 확인한 뒤에 잠근다).
 */
const { decide, ADOPT } = await import("../../src/lib/genesis/ruleStats");

let 나쁨 = 0;
const 재기 = (n: string, ok: boolean, 본?: unknown) => { if (!ok) 나쁨++; console.log(ok ? "통과" : "실패", n, ok ? "" : JSON.stringify(본)); };
/** a: 어기고 실패 · b: 어기고 성공 · c: 지키고 실패 · d: 지키고 성공 */
const 판 = (a: number, b: number, c: number, d: number) => decide({ a, b, c, d });

console.log(`문턱: 어긴 사례 ${ADOPT.minSupport} 이상 · 어기고 실패 ${ADOPT.minBadViolators} 이상 · lift ${ADOPT.minLift} · p ${ADOPT.maxP}\n`);

/* ── 못 잼: 재 볼 재료가 모자란 것 ── */
재기("어긴 사례가 0건이면 **못 잼**", 판(0, 0, 5, 20).판정 === "못잼", 판(0, 0, 5, 20));
재기("어긴 사례가 2건이면(문턱 3 미만) **못 잼**", 판(1, 1, 5, 20).판정 === "못잼", 판(1, 1, 5, 20));
재기("어기고 실패한 사례가 1건뿐이면 **못 잼**", 판(1, 5, 2, 20).판정 === "못잼", 판(1, 5, 2, 20));

/* ── 기각: 재 봤는데 떨어진 것 ── */
재기("재 봤는데 효과가 작으면 **기각**", 판(5, 20, 5, 20).판정 === "기각", 판(5, 20, 5, 20));

/* ── 채택 ── */
const 좋 = 판(8, 2, 2, 18);
재기("어긴 쪽이 훨씬 더 실패하면 **채택**", 좋.판정 === "채택", 좋);

/* ── **이 자의 심장**: 셋이 서로 다른 칸이어야 한다 ── */
재기("못 잼은 채택이 아니다", 판(0, 0, 5, 20).adopt === false);
재기("기각도 채택이 아니다", 판(5, 20, 5, 20).adopt === false);
재기("못 잼과 기각이 **다른 말을 한다**", 판(0, 0, 5, 20).판정 !== 판(5, 20, 5, 20).판정);
재기("못 잼은 '다시 잰다' 고 적는다", 판(0, 0, 5, 20).reason.includes("다시"), 판(0, 0, 5, 20).reason);

if (process.argv.includes("--sabotage")) {
  /* 심은 고장: 셋을 다시 둘로 되돌린 판(못 잼을 기각으로 묻는다).
     이걸 못 잡으면 이 자는 아무것도 안 지키는 것이다. */
  const 고장난 = (a: number, b: number, c: number, d: number) => (판(a, b, c, d).adopt ? "채택" : "기각");
  console.log("\n[--sabotage] 못 잼을 기각으로 되돌린 판으로 바꿔 센다");
  const 보기: [number, number, number, number][] = [[0, 0, 5, 20], [1, 1, 5, 20], [1, 5, 2, 20]];
  const 잡힘 = 보기.filter((v) => 고장난(...v) !== 판(...v).판정).length;
  console.log(잡힘 === 보기.length ? `통과 심은 고장 ${잡힘}개를 전부 갈라낸다(이빨 있다)` : `실패 ${보기.length}개 중 ${잡힘}개만`);
  if (잡힘 !== 보기.length) 나쁨++;
}

console.log(나쁨 === 0 ? "\n전부 통과" : `\n실패 ${나쁨}건`);
process.exit(나쁨 === 0 ? 0 : 1);
