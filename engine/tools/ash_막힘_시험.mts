/**
 * **막히는가** (10-09 사장님 "장비 제작의 필요성"). 모델 0 · 값 0.
 *   ASH_URL=http://127.0.0.1:8124/ash/index.html npx tsx engine/tools/ash_막힘_시험.mts [끝층=32]
 *
 * 이 게임의 고리는 `전투 → 재료 → 대장간 → 장비 → 더 높은 층` 인데,
 * **맨 끝 화살표가 끊겨 있었다** — 30층까지 한 대도 안 맞아서 앞의 셋이 전부 장식이었다.
 *
 * 그래서 **막힘** 하나만 잰다. 그리고 반드시 **대조군과 같이** 잰다:
 *   · 맨몸으로 올라가면 **어디서 막히나**  ← 막혀야 한다
 *   · 장비를 끼고 가면 **그 층을 넘나**     ← 넘어야 한다
 * 하나만 보면 "뭐든 모자라다"가 통과해 버린다(09-22 사장님 교훈).
 *
 * 게임 안의 한턴() 을 그대로 돌린다 — 따로 셈을 베끼면 게임과 다른 것을 재게 된다.
 */
import { openHeadless } from "../../src/lib/video/headless";
import { 이름헬퍼 } from "./ash_공통.mjs";

const 주소 = process.env.ASH_URL ?? "https://rookery-web-production.up.railway.app/ash/index.html";
/* 10-11: 기본 25 로 두니 **30층 판정 둘이 영영 못 잰 채 실패**로 찍혔다.
   자가 보는 마지막 관문보다 끝층이 낮으면 그 줄은 고장이 아니라 눈이 없는 것이다. */
const 끝층 = Number(process.argv[2] ?? 32);
/** `--끝만` — 맨 윗 티어 한 칸만 돌린다. 대조군 열한 개를 100층까지 돌리면 한 시간이 넘는데,
    "끝이 닫히는가" 하나만 묻고 싶을 때가 있다(10-11: T10 줄이 턴 바닥으로 못 재졌다). */
const 끝만 = process.argv.includes("--끝만");

type 한판 = { 층: number; 깸: number; 전멸: number; 턴: number; 체력: number; 레벨: number; 공격: number; 금화: number };

/* 대조군이 열 개 × 100층이라 한 번의 evaluate 가 몇 분 간다.
   puppeteer 기본 180초로는 **자가 잘린다** — 10-11 에 실제로 그렇게 죽었다(고장이 아니었다). */
/* `--끝만` 은 100층 꼭대기까지 자격(21판)을 다 채우며 올라가므로 **몇 시간** 간다.
   10-11 에 40분으로 걸었다가 또 잘렸다 — 그것도 고장이 아니라 못 잰 것이었다. */
const 창 = await openHeadless({ width: 390, height: 844, protocolTimeout: (끝만 ? 240 : 40) * 60_000 });
if (!창) process.exit(1);
try {
  const page = await 창.browser.newPage();
  await page.setViewport({ width: 390, height: 844, deviceScaleFactor: 2 });
  await 이름헬퍼(page);
  await page.goto(주소, { waitUntil: "networkidle2", timeout: 60_000 });
  await new Promise((r) => setTimeout(r, 1800));

  const 본 = await page.evaluate(([끝층, 끝만]: [number, boolean]) => {
    const w = window as any;
    for (let i = 1; i < 9999; i++) clearInterval(i);
    try { localStorage.clear(); } catch { /* 없어도 된다 */ }
    /* **난수를 고정한다.** 전투에 난수가 많아 같은 설정으로도 판마다 결과가 달라진다 —
       10-10 에 같은 코드로 "실패 2건"과 "전부 통과"가 번갈아 나왔다.
       밸런스를 숫자로 판정하는 자는 흔들리면 안 된다. 뽑기는 고정하고, 대신
       **세 가지 씨앗**으로 돌려 운에 기대지 않는지 본다(아래 `씨앗들`). */
    const 씨 = (시작: number) => { let x = 시작; return () => { x = (x * 1103515245 + 12345) & 0x7fffffff; return x / 0x7fffffff; }; };
    /* **화면 갱신 루프를 멈춘다.** `그리기()` 가 requestAnimationFrame 으로 계속 도는데,
       그 안의 파티클이 Math.random 을 **자와 경쟁해서** 뽑아 간다. 그래서 씨앗을 고정해도
       자가 몇 번째 난수를 받을지가 타이밍에 따라 달라져 결과가 흔들렸다
       (10-10: 같은 코드로 "실패 2건"과 "전부 통과"가 번갈아 나왔다). */
    (window as any).requestAnimationFrame = () => 0;

    const 오르기 = (장비끼고: boolean, 최대열림 = 99, 시작 = 20251010) => {
      Math.random = 씨(시작);
      // 처음부터 다시 — 대원·가방·층을 전부 비운다(앞 판의 레벨이 묻으면 대조군이 안 된다)
      w.S.대원.length = 0; w.S.파티.length = 0;
      for (const k of ["기사", "검사", "회복술사"]) w.S.대원.push(w.대원만들기(k));
      w.S.파티 = w.S.대원.map((c: any) => c.id);
      w.S.대표 = w.S.대원[0].id;
      w.S.가방.장비 = []; w.S.가방.약 = 0; w.S.약수 = 0;
      w.S.깸 = {}; w.S.보스깸 = []; w.S.금화 = 0;
      /* 10-11: 여기서 **파편·잔혼·수호핵만** 비우고 있었다. 가죽·강철·이빨·거인뼈는
         앞 대조군이 모아 둔 것이 그대로 넘어가, 뒤에 도는 판일수록 공짜로 유리했다.
         대조군은 서로의 흔적 위에서 재면 안 된다 — **재료 칸을 전부** 0 으로 둔다. */
      for (const k of Object.keys(w.재료이름)) w.S.가방[k] = 0;
      w.S.가방.별가루 = 0; w.S.조각 = 0; w.S.뽑은수 = 0;
      w.S.층 = 1; w.S.단계 = 1; w.S.사냥층 = 1; w.S.자동오름 = true; w.S.쉼 = 0;
      w.S.최고층 = w.열린층(); w.S.진행 = true;
      w.전투준비(); w.적만들기();

      const 길: Array<{ 층: number; 깸: number; 전멸: number; 턴: number; 체력: number; 레벨: number; 공격: number; 금화: number }> = [];
      let 턴 = 0, 층턴 = 0, 앞층 = 1, 전멸 = 0, 막힌층 = 0, 층전멸 = 0, 최고닿은 = 1;
      const 체력 = () => {
        const p = w.S.대원.filter((c: any) => w.S.파티.includes(c.id));
        return Math.round(p.reduce((a: number, c: any) => a + Math.max(0, c.hp) / w.최대체력(c), 0) / p.length * 100);
      };
      const 꾸미기 = () => {
        /* 그 층에서 만들 수 있는 것 중 **슬롯마다 가장 좋은 것**을 끼운다.
           빈 칸만 채우면 철검을 낀 채로 대검을 영영 안 들게 돼 T2 를 못 재게 된다.
           재료·금화는 넉넉히 준다 — 이 자는 "장비가 있으면 넘는가"를 보는 자다.
           **재료를 못 구해 막히는 것**(자물쇠)은 ash_시장_시험.mts 가 따로 본다. */
        if (!장비끼고) return;
        /* 10-11: 여기 재료 목록을 **손으로 적어 두고 있었다.** 4구간 재료(석편·저울추)를
           더했더니 목록에 없어서 T5 가 영영 안 만들어졌고, 자는 그걸 "T5 를 껴도 50층에서 막힘"
           으로 찍었다 — 사실은 **T5 를 한 번도 안 낀 것**이었다.
           재료가 늘 때마다 자를 고쳐야 하는 목록은 결국 안 고쳐진다. **표에서 읽는다.** */
        /* 10-11 **두 번째로 같은 모양에 속았다.** 금화를 9,999만으로 박아 뒀는데
           T9 가 2.6억, T10 이 12억이라 **둘 다 한 번도 안 껴졌다.** 그런데도 자는
           "T9 를 끼고도 90층에서 막힌다"로 찍었다 — 사실은 안 낀 것이었다.
           이 자는 "**장비가 있으면 넘는가**"를 보는 자다. 돈은 여기서 재는 것이 아니므로
           레시피 값이 아무리 올라도 안 걸리게 둔다(돈이 되는가는 ash_체감.mts 가 본다). */
        w.S.금화 = Number.MAX_SAFE_INTEGER;
        for (const k of Object.keys(w.재료이름)) w.S.가방[k] = 9999;
        const 값 = (k: string) => Object.values(w.레시피[k].효과 ?? {}).reduce((a: number, b: any) => a + Number(b), 0);
        for (const 슬롯 of ["무기", "갑옷"]) {
          const 고를 = Object.keys(w.레시피)
            .filter((k) => w.레시피[k].슬롯 === 슬롯 && w.레시피[k].열림 <= 최대열림 && !w.모자람(k).length)
            .sort((a, b) => 값(b) - 값(a))[0];
          if (!고를) continue;
          for (const c of w.S.대원) {
            const 낀 = w.S.가방.장비.find((x: any) => x.누구 === c.id && w.레시피[x.키].슬롯 === 슬롯);
            if (낀 && 낀.키 === 고를) continue;
            if (w.만들기(고를)) { const t = w.S.가방.장비[w.S.가방.장비.length - 1]; w.장착(t.id, c.id); }
          }
        }
      };

      let 최저 = 100;
      /* 10-11: 턴 한도가 400,000 고정이라 **80층대에서 바닥났다**(80층 한 층에만 67,790턴).
         그러면 '막힌층 0 · 닿은층 83' 이 나오는데, 그건 막힌 게 아니라 **못 잰 것**이다.
         끝층에 맞춰 늘리고, 바닥났는지를 따로 들고 나간다. */
      const 턴한도 = 끝만 ? 60_000_000 : Math.max(400_000, 끝층 * 60_000);
      while (턴 < 턴한도) {
        const 쉼앞 = w.S.쉼;
        w.한턴(); 턴++; 층턴++;
        // **전투 중**에 재야 한다. 판이 끝난 뒤엔 전투준비()가 이미 체력을 꽉 채워서 늘 100%로 보인다.
        if (!w.S.쉼) 최저 = Math.min(최저, 체력());
        if (w.S.쉼 > 쉼앞) { 전멸++; 층전멸++; }
        if (w.S.층 !== 앞층) {
          길.push({ 층: 앞층, 깸: w.S.깸[앞층] ?? 0, 전멸: 층전멸, 턴: 층턴, 체력: 최저,
                    레벨: w.S.대원[0]?.레벨 ?? 0, 공격: w.공격력(w.S.대원[0]), 금화: w.S.금화 });
          앞층 = w.S.층; 층턴 = 0; 층전멸 = 0; 최저 = 100;
          꾸미기();                                   // 새 층에 들어설 때마다 만들 수 있는 걸 만든다
          if (w.S.층 > 끝층) break;
        }
        /* **막혔다**의 신호 둘 — 게임이 10-09부터 관문 패배를 스스로 처리한다:
           ① 관문에서 져서 자동 등반이 꺼지고 아래층으로 밀려났다
           ② 같은 층에서 세 번 전멸(관문이 아닌 곳에서 막힌 경우) */
        if (!w.S.자동오름) { 막힌층 = 최고닿은; break; }
        if (층전멸 >= 3) { 막힌층 = w.S.층; break; }
        최고닿은 = Math.max(최고닿은, w.S.층);
      }
      return { 길, 전멸, 막힌층, 닿은층: 최고닿은, 턴, 턴바닥: 턴 >= 턴한도 && !막힌층, 보스깸: [...(w.S.보스깸 ?? [])] };
    };

    /* 셋을 나란히 잰다 — **T1 만으로 20층을 넘어 버리면 T2 를 만들 이유가 없다.**
       그 줄은 "장비를 끼면 넘는다" 하나만 봐서는 절대 안 보인다. */
    /* 넷을 나란히 잰다 — 층대마다 **다음 장비**를 요구해야 고리가 한 바퀴 더 돈다.
       T2 만으로 30층을 넘어 버리면 T3 가 장식이 된다(T1 이 20층을 넘던 것과 같은 구멍). */
    /* 10-11 T4 가 생겼다(거인뼈, 열림 30). 전에는 `장비`(열림 제한 없음)가 곧 T3 였는데
       이제는 T4 다 — **T3 만 끼운 칸을 따로 두지 않으면** 넷째 관문 판정을 할 수가 없다. */
    if (끝만) return { 장비: 오르기(true) } as any;
    return { 맨몸: 오르기(false), T1: 오르기(true, 5), T2: 오르기(true, 10), T3: 오르기(true, 20), T4: 오르기(true, 30), T5: 오르기(true, 40), T6: 오르기(true, 50), T7: 오르기(true, 60), T8: 오르기(true, 70), T9: 오르기(true, 80), 장비: 오르기(true) };
    void 0;
  }, [끝층, 끝만] as any);

  for (const 이름 of (끝만 ? ["장비"] : ["맨몸", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "장비"]) as any[]) {
    const r = (본 as any)[이름];
    console.log(`\n── ${이름} ──  닿은 층 ${r.닿은층} · 전멸 ${r.전멸}번${r.막힌층 ? ` · **${r.막힌층}층에서 막힘**` : " · 안 막힘"}`);
    /* 10-11: **금화 칸을 더한다.** T5 가 안 만들어진 판에서 자가 이유를 못 말해 줬다 —
       공격력만 보고 "안 꼈다"까지는 알아도, 재료가 없어서인지 돈이 없어서인지는 몰랐다. */
    console.log("   층   깸   전멸   턴   최저체력   레벨   공격      금화");
    for (const x of r.길 as 한판[]) if (x.층 % 5 === 0 || x.층 === 1 || x.층 % 10 === 0)
      console.log(`  ${String(x.층).padStart(3)} ${String(x.깸).padStart(4)} ${String(x.전멸).padStart(5)} ${String(x.턴).padStart(5)} ${`${x.체력}%`.padStart(9)} ${String(x.레벨).padStart(6)} ${String(x.공격).padStart(6)} ${String(x.금화).padStart(9)}`);
  }
  /* ── 판정 ───────────────────────────────────────────────────
     **둘 다** 성립해야 고리가 이어진 것이다. 하나만 보면
     "뭐든 모자라다"가 통과해 버린다(09-22 사장님 교훈). */
  let 나쁨 = 0;
  const 재기 = (n: string, ok: boolean, 본?: unknown) => { if (!ok) 나쁨++; console.log((ok ? "통과" : "실패"), n, ok ? "" : JSON.stringify(본)); };
  if (끝만) {
    const r = 본.장비 as any;
    console.log(r.턴바닥
      ? `  ⚠ 턴이 바닥나 ${r.닿은층}층에서 멈췄다 — 못 잼`
      : `  T10 — 닿은 층 ${r.닿은층} · ${r.막힌층 ? `${r.막힌층}층에서 막힘` : "안 막힘"} · 100층 보스 ${(r.보스깸 ?? []).includes(100) ? "**깼다**" : "못 깼다"}`);
    process.exit((r.보스깸 ?? []).includes(100) ? 0 : 1);
  }
  const 맨 = 본.맨몸 as any, 티1 = (본 as any).T1, 티2 = (본 as any).T2, 티3 = (본 as any).T3, 티4 = (본 as any).T4, 티5 = (본 as any).T5, 티6 = (본 as any).T6, 티7 = (본 as any).T7, 티8 = (본 as any).T8, 티9 = (본 as any).T9, 장 = 본.장비 as any;
  // 첫 벽은 **10층**이어야 한다(사장님 10-09). 20층이면 너무 늦어서, 그때까지 정비 없이 오토만 돈다.
  재기("맨몸은 첫 관문(10층)에서 막힌다", 맨.막힌층 === 10, { 막힌층: 맨.막힌층, 닿은층: 맨.닿은층 });
  재기("T1 을 끼면 첫 관문을 넘는다", 티1.닿은층 > 맨.막힌층, { 맨몸: 맨.막힌층, T1: 티1.닿은층 });
  // **T1 만으로 20층까지 가면 T2 가 장식이 된다** — 다음 관문이 다음 장비를 요구해야 고리가 한 바퀴 더 돈다
  재기("T1 만으로는 둘째 관문(20층)에서 막힌다", 티1.막힌층 === 20, { 막힌층: 티1.막힌층, 닿은층: 티1.닿은층 });
  재기("T2 를 끼면 둘째 관문을 넘는다", 티2.닿은층 > 20, { T1: 티1.막힌층, T2: 티2.닿은층 });
  재기("T2 만으로는 셋째 관문(30층)에서 막힌다", 티2.막힌층 === 30, { 막힌층: 티2.막힌층, 닿은층: 티2.닿은층 });
  재기("T3 를 끼면 셋째 관문을 넘는다", 티3.닿은층 > 30, { T2: 티2.막힌층, T3: 티3.닿은층 });
  /* 10-11 넷째 칸. T4(거인뼈) 가 없던 동안 **여기가 아예 안 재지고 있었다** —
     T3 가 곧 최고 장비라 "막힌다"가 고장인지 끝인지 가를 수가 없었다. */
  재기("T3 만으로는 넷째 관문(40층)에서 막힌다", 티3.막힌층 === 40, { 막힌층: 티3.막힌층, 닿은층: 티3.닿은층 });
  재기("T4 를 끼면 넷째 관문을 넘는다", 티4.닿은층 > 40, { T3: 티3.막힌층, T4: 티4.닿은층 });
  재기("T4 만으로는 다섯째 관문(50층)에서 막힌다", 티4.막힌층 === 50, { 막힌층: 티4.막힌층, 닿은층: 티4.닿은층 });
  재기("T5 를 끼면 다섯째 관문을 넘는다", 티5.닿은층 > 50, { T4: 티4.막힌층, T5: 티5.닿은층 });
  재기("T5 만으로는 여섯째 관문(60층)에서 막힌다", 티5.막힌층 === 60, { 막힌층: 티5.막힌층, 닿은층: 티5.닿은층 });
  재기("T6 을 끼면 여섯째 관문을 넘는다", 티6.닿은층 > 60, { T5: 티5.막힌층, T6: 티6.닿은층 });
  재기("T6 만으로는 일곱째 관문(70층)에서 막힌다", 티6.막힌층 === 70, { 막힌층: 티6.막힌층, 닿은층: 티6.닿은층 });
  재기("T7 을 끼면 일곱째 관문을 넘는다", 티7.닿은층 > 70, { T6: 티6.막힌층, T7: 티7.닿은층 });
  재기("T7 만으로는 여덟째 관문(80층)에서 막힌다", 티7.막힌층 === 80, { 막힌층: 티7.막힌층, 닿은층: 티7.닿은층 });
  재기("T8 을 끼면 여덟째 관문을 넘는다", 티8.닿은층 > 80, { T7: 티7.막힌층, T8: 티8.닿은층 });
  /* **턴이 바닥나 멈춘 판은 판정하지 않는다** — 막힌 게 아니라 못 잰 것이다.
     통과로 세도, 실패로 세도 둘 다 거짓말이 된다(10-11, 09-27 교훈). 그대로 적는다. */
  const 못잼 = (r: any, 누구: string) => {
    if (!r.턴바닥) return false;
    console.log(`  ⚠ ${누구} — 턴이 바닥나 ${r.닿은층}층에서 멈췄다(막힌 게 아니다). 끝층을 낮추거나 한도를 늘려라.`);
    return true;
  };
  if (!못잼(티8, "T8")) 재기("T8 만으로는 아홉째 관문(90층)에서 막힌다", 티8.막힌층 === 90, { 막힌층: 티8.막힌층, 닿은층: 티8.닿은층 });
  if (!못잼(티9, "T9")) {
    재기("T9 를 끼면 아홉째 관문을 넘는다", 티9.닿은층 > 90, { T8: 티8.막힌층, T9: 티9.닿은층 });
    재기("T9 만으로는 마지막 관문(100층)에서 막힌다", 티9.막힌층 === 100, { 막힌층: 티9.막힌층, 닿은층: 티9.닿은층 });
  }
  if (!못잼(장, "T10")) {
    /* **100층은 끝이다.** 더 갈 데가 없으므로 "막힌다"로는 못 잰다 — 깼는지로 잰다. */
    재기("T10 으로 100층 보스를 깬다", (장.보스깸 ?? []).includes(100), { 닿은층: 장.닿은층, 보스깸: 장.보스깸 });
    console.log(`
  T10 으로 닿은 층 ${장.닿은층} · ${장.막힌층 ? `${장.막힌층}층에서 막힘` : "끝까지"}`);
  }
  재기("초반(1~9층)은 안 막힌다", (맨.길 as 한판[]).filter((x) => x.층 < 10).every((x) => x.전멸 === 0),
    (맨.길 as 한판[]).filter((x) => x.층 < 10).map((x) => [x.층, x.전멸]));
  // 레벨이 층을 앞지르면 되돌이를 돌수록 쉬워진다(10-09 실측: 25층에서 Lv.64였다)
  재기("레벨이 층을 크게 앞지르지 않는다", (장.길 as 한판[]).every((x) => x.레벨 <= x.층 + 4),
    (장.길 as 한판[]).map((x) => [x.층, x.레벨]).slice(-5));
  console.log(나쁨 === 0 ? "전부 통과" : `실패 ${나쁨}건`);
  if (나쁨) process.exitCode = 1;
} finally { await 창.browser.close(); await 창.close?.(); }
