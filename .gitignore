# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# engine (파이썬 판정·연출가 엔진, 09-05 genesis-project 에서 옮겨 옴)
engine/__pycache__/
engine/**/__pycache__/
engine/.pytest_cache/
engine/.venv/
engine/data/*.db
engine/data/*.db-journal
engine/data/*.log
engine/data/repos/
engine/data/review_queue.json
engine/data/tunnel*.log
engine/.secrets/
engine/out/
engine/tools/bin/

# 09-18: 커밋에서 빼는 것 — 돌 때마다 생기는 로그, 시험 영상, 스토어 묶음
/data/*.log
/data/unity_watch.last
/test.mp4
/engine/docs/store/*.zip

# 로키 열쇠 (10-12) — 저장소에 올라가면 안 된다. 작업 스케줄러가 보는 유일한 자리라 여기 둔다
.keys/

# 두근도트 이사 덤프·복원 SQL — **계정 비밀번호 해시와 이메일이 들어 있다.** git 에 두지 않는다 (10-24)
engine/work/dot-이사/dot-dump.json
engine/work/dot-이사/복원.sql

# 구글 OAuth 비밀이 **파일 이름 자체**인 파일 (10-29). 저장소 맨 위에 그냥 놓여 있었고
# `git add -A` 한 번이면 커밋된다. 이름이 비밀이라 내용이 비어도 위험하다.
GOCSPX-*
/engine/work/dot-이사/복원-나머지.sql
