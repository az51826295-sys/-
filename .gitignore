# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# engine (파이썬 판정·연출가 엔진, 09-05 genesis-project 에서 옮겨 옴)
engine/__pycache__/
engine/**/__pycache__/
engine/.pytest_cache/
engine/.venv/
engine/data/*.db
engine/data/*.db-journal
engine/data/*.log
engine/data/repos/
engine/data/review_queue.json
engine/data/tunnel*.log
engine/.secrets/
engine/out/
engine/tools/bin/

# 09-18: 커밋에서 빼는 것 — 돌 때마다 생기는 로그, 시험 영상, 스토어 묶음
/data/*.log
/data/unity_watch.last
/test.mp4
/engine/docs/store/*.zip
.deploy-commit
