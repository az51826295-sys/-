{
  "mcpServers": {
    "rookery": {
      "type": "http",
      "url": "${ROOKERY_URL:-https://rookery-web-production.up.railway.app}/api/mcp",
      "headers": {
        "Authorization": "Bearer ${ROOKERY_MCP_TOKEN}"
      }
    },
    "rookery-director": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "engine/tools/director_mcp.mts"]
    }
  }
}
